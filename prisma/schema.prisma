// DAFLOW — schema de base de datos
// Ver daflow-especificacion.md para el modelo de negocio completo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ---------------- Configuración global de la plataforma ----------------
 */
model PlatformSettings {
  id                           String    @id @default("singleton")
  adminPasswordHash            String
  adminEmail                   String?
  logoUrl                      String?
  // Marca de agua opcional (logo + wordmark) mostrada discretamente en la tarjeta de Inicio.
  bannerUrl                    String?
  // Ícono de la pestaña del navegador — si no se sube uno, se usa el /icon.svg genérico por defecto.
  faviconUrl                   String?
  // Cumpleaños del admin — el único perfil sin un User real detrás, así que
  // vive aquí en vez de en la tabla User.
  adminBirthDate               DateTime?
  // Confirmado 2026-08-05: contador único para el código correlativo de
  // Control de Compras (SC-001, SC-002...) — una sola secuencia para todo el
  // módulo, sin importar quién solicite. Incrementado dentro de una
  // transacción al crear el primer PurchaseRequest de un grupo nuevo, y
  // copiado a todas las filas de ese mismo grupo.
  lastPurchaseRequestNumber    Int       @default(0)
  // Confirmado 2026-08-19: correlativo propio de Reingreso de Mercadería
  // (RM-0001, RM-0002...) — mismo patrón atómico que lastPurchaseRequestNumber,
  // una sola numeración para todo el módulo sin importar quién capture el lote.
  lastMerchandiseReentryNumber Int       @default(0)
  // Confirmado 2026-08-25: correlativo propio de "Reclamo posterior al
  // cierre" (RPC-0001, RPC-0002...) — mismo patrón atómico que los dos de
  // arriba, distinto de lastPurchaseRequestNumber porque el reclamo puede no
  // tener un origen exacto (mercadería mezclada).
  lastLateClaimNumber          Int       @default(0)
  // Confirmado 2026-08-25: correlativo propio de Registro de Egresos
  // (EG-0001, EG-0002...) — mismo patrón atómico que los anteriores, una
  // sola numeración para todo el módulo sin importar el motivo.
  lastMerchandiseOutflowNumber Int       @default(0)
  // Confirmado 2026-08-25: correlativo propio de Ventas Externas (VE-0001,
  // VE-0002...) — mismo patrón atómico que los anteriores.
  lastExternalSaleNumber       Int       @default(0)
  // Confirmado 2026-08-25: correlativo propio de Guías Canceladas (GC-0001,
  // GC-0002...) — mismo patrón atómico que los anteriores.
  lastCancelledGuideNumber     Int       @default(0)
  updatedAt                    DateTime  @updatedAt
}

// Token temporal para el flujo de "olvidé mi contraseña" del administrador
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/**
 * ---------------- Áreas del negocio ----------------
 */
model Department {
  id                    String   @id @default(cuid())
  name                  String
  code                  String   @unique
  order                 Int      @default(0)
  // Áreas especiales (ej. proyectos confidenciales) se anclan aparte en el menú,
  // no se mezclan con la lista arrastrable de áreas normales del negocio.
  isSpecial             Boolean  @default(false)
  // Habilita la pestaña de KPIs financieros (ROI, ventas y ganancia mensual) para esta área.
  trackKpis             Boolean  @default(false)
  // Habilita el registro semanal (ej. pedidos despachados) que se muestra en el Inicio para todos.
  trackWeeklyMetric     Boolean  @default(false)
  // Habilita la bitácora de feedback semanal: problemas y plan de acción.
  // El admin puede escribir manualmente; el asistente de check-in semanal
  // también escribe (por su propio camino, ver CheckinConversation) cuando
  // el empleado reporta directo. El líder del área puede ver siempre, y
  // cambiar el estado (Pendiente/Solucionado/Rechazado) de sus propios
  // registros — ver canEditDeptKpis.
  trackWeeklyReview     Boolean  @default(false)
  // Habilita "Pagos recordatorios" (facturas/suscripciones mensuales que vencen en fechas
  // variables) — confirmado 2026-07-22: solo Finanzas y Contabilidad, por ahora.
  trackPaymentReminders Boolean  @default(false)
  createdAt             DateTime @default(now())

  users                     User[]
  processes                 Process[]
  documents                 Document[]
  exams                     Exam[]
  leaders                   User[]                        @relation("DeptLeader")
  positions                 Position[]
  financeOperations         FinanceOperation[]
  financeKpis               FinanceKpiRecord[]
  financeSharedBalances     FinanceSharedMonthlyBalance[]
  financeKpiUploads         FinanceKpiUpload[]
  inventoryProductSnapshots InventoryProductSnapshot[]
  financeKpiSettings        FinanceKpiSettings?
  weeklyMetrics             WeeklyMetricRecord[]
  weeklyReviews             WeeklyReviewRecord[]          @relation("WeeklyReviewDept")
  involvedInWeeklyReviews   WeeklyReviewRecord[]          @relation("WeeklyReviewInvolvesDept")
  paymentReminders          PaymentReminder[]
  periodicReminders         PeriodicReminder[]
  nancyConversations        NancyConversation[]
  checkinConversations      CheckinConversation[]
  purchaseRequests          PurchaseRequest[]

  @@index([order])
}

// Catálogo de puestos/cargos que el admin arma por área, para elegir al dar de alta a alguien
model Position {
  id     String     @id @default(cuid())
  deptId String
  dept   Department @relation(fields: [deptId], references: [id], onDelete: Cascade)
  name   String

  @@unique([deptId, name])
  @@index([deptId])
}

/**
 * ---------------- Personas (nómina + acceso) ----------------
 */
model User {
  id           String      @id @default(cuid())
  name         String
  username     String      @unique
  passwordHash String
  deptId       String?
  department   Department? @relation(fields: [deptId], references: [id], onDelete: SetNull)

  // Off = someone left the company: blocked from logging in (checked at
  // auth time and re-checked on every /area request in case they're already
  // logged in), and hidden from the org chart. Everything else about them —
  // Nómina profile, isLeader, historial — stays intact so reactivating them
  // restores exactly what they had before.
  isActive Boolean @default(true)

  photoUrl  String?
  position  String?
  email     String?
  phone     String?
  startDate DateTime?
  birthDate DateTime?
  skills    String[]  @default([])
  cvUrl     String?
  cvName    String?

  isLeader    Boolean     @default(false)
  leadsDeptId String?
  leadsDept   Department? @relation("DeptLeader", fields: [leadsDeptId], references: [id], onDelete: SetNull)

  // Puede crear/editar documentos en "Leyes y Reglamentos" (visibles para toda la empresa), pero no eliminarlos.
  canManageLaws Boolean @default(false)

  // Puede proponer proveedores nuevos (quedan "Pendiente" hasta que su líder los apruebe). No puede editar ni eliminar.
  canAddSuppliers Boolean @default(false)

  // Escape hatch para Control de Compras sin ser líder del área —
  // confirmado 2026-07-30: Control de Compras no es "la página de mi
  // departamento" de nadie en particular (lo usan tanto Compras como
  // Finanzas), así que el acceso vive en este flag directo en vez de en
  // isLeader+leadsDeptId==COM. Admin siempre puede, sin necesitar el flag.
  canManagePurchases Boolean @default(false)

  // Escape hatch para Pagos administrativos (Finanzas) — confirmado
  // 2026-08-06: por defecto solo el líder de Finanzas (y admin) gestiona
  // esto; a diferencia de canManagePurchases, no incluye a Compras.
  canManageAdminPayments Boolean @default(false)

  // Confirmado 2026-08-18: pedido explícito del usuario — delegar a
  // personas puntuales (hoy Jariel y Bryan) la posibilidad de AGREGAR una
  // cuenta bancaria a un proveedor desde la sección Proveedores (al crearlo,
  // o después desde su ficha). Deliberadamente NO les da acceso a VER las
  // cuentas ya registradas de otros proveedores (eso sigue siendo exclusivo
  // de admin vía canViewSupplierBankAccounts) — solo pueden sumar una nueva.
  canAddSupplierBankAccounts Boolean @default(false)

  // Escape hatch para Servicio Postventa —
  // confirmado 2026-07-25: por defecto solo el líder de Análisis de Mercado
  // (y admin) gestiona esto; el admin puede delegarlo a alguien más puntualmente.
  canManageStoreFeedback Boolean @default(false)
  // Nivel de acceso separado, solo lectura — confirmado 2026-07-25: para
  // líderes de otras áreas (ej. líder de ventas) que deben poder ver el
  // detalle y contactar por WhatsApp, pero nunca crear/editar/eliminar.
  canViewStoreFeedback   Boolean @default(false)

  // Mismo patrón — confirmado 2026-08-04: Control de Inventario (KPIs de
  // inventario) no es "la página de mi departamento" de Daniel; se resuelve
  // via isLeader+leadsDept.code==="INV" en canManageInventoryControl(), pero
  // se deja aquí el mismo tipo de escape hatch para delegar puntualmente sin
  // tocar código, igual que canManagePurchases.
  canManageInventoryControl Boolean @default(false)

  // Escape hatch para Caja Chica Secundaria (hoy Bryan Ríos) — mismo patrón
  // que canManagePurchases: no es "la página de su departamento" (Bryan
  // lidera Análisis de Mercado, no un departamento de caja chica), así que
  // el acceso vive en este flag directo. Admin siempre puede, sin el flag.
  canManagePettyCashSecundaria Boolean @default(false)

  // Confirmado 2026-08-25 (Fase 3 de Registro de Egresos — Ventas Externas):
  // delegado puntual a los "asesores" que venden por fuera de Dropi/Rocket
  // (hoy Heidy, Jariel, Yair, Marcos) — ninguno lidera Análisis de Mercado,
  // así que el acceso vive en este flag directo, mismo patrón que
  // canManagePurchases. Admin siempre puede, sin el flag.
  canDeclareExternalSales Boolean @default(false)

  // Confirmado 2026-08-29, pedido explícito del usuario: hoy solo Marcos
  // vende contra entrega (cobra después de despachar); los demás asesores
  // de Ventas Externas venden con pago anticipado. Se congela en
  // ExternalSale.isContraEntrega al declarar, para que un cambio futuro de
  // este flag no altere ventas ya en curso.
  externalSaleContraEntrega Boolean @default(false)

  // Confirmado 2026-08-28: escape hatch puntual para que alguien de
  // despacho (hoy Yair) vea "Mercadería recibida" en su propia "Mi área de
  // trabajo" en modo SOLO LECTURA (nunca confirma diseño ni asesor — esos
  // siguen siendo canConfirmMarketingDesign/Advisor), para saber qué llegó a
  // bodega y ir organizando el despacho. Recibe push cuando Daniel aprueba
  // una recepción, igual que design/advisor.
  canViewMarketingArrivalsForDispatch Boolean @default(false)

  // Confirmado 2026-08-08: "Mercadería recibida" (Análisis de Mercado) —
  // dos flags separados porque son dos tareas totalmente distintas sobre la
  // misma llegada. canConfirmMarketingDesign = el diseñador de AMBAS marcas
  // (hoy Robert) sube fotos reales brandeadas + video publicitario en Drive.
  // canConfirmMarketingAdvisor = el asesor de cualquiera de las dos marcas
  // (hoy Heidy — Importadora Damián — o Jariel — Provedix) verifica stock,
  // precio de venta, descripción y Dropi. Ambos ven TODAS las llegadas (no
  // hay campo de marca real en el catálogo); la marca que se muestra en
  // pantalla es solo informativa, derivada de quién confirmó. Admin siempre
  // puede ambas cosas, sin necesitar el flag.
  canConfirmMarketingDesign  Boolean @default(false)
  canConfirmMarketingAdvisor Boolean @default(false)
  // Solo informativo (mismo espíritu que Store.brand) — qué marca asesora
  // esta persona, para mostrarla junto a su nombre cuando confirma. Nunca se
  // usa para filtrar ni bloquear quién ve o puede confirmar qué llegada.
  marketingAdvisorBrand      String?

  // Confirmado 2026-08-05: excluye a esta persona de "Colaborador del mes"
  // por completo — su líder ya no la ve en su lista para calificar, y nunca
  // se generan evaluaciones nuevas para ella. No borra evaluaciones pasadas.
  excludeFromRecognition Boolean @default(false)

  // Pestaña con la que "Mi área de trabajo" abre para ESTE usuario en vez del
  // default por departamento — confirmado 2026-08-04 (ej. Nairoby o el admin
  // pueden preferir otra distinta a "Feedback semanal"). Null = usar el
  // default de siempre.
  defaultWorkspaceTab String?

  // Última vez que este usuario (como líder) revisó el Feedback semanal de su área — usado para el
  // contador de "sin leer" en el sidebar. Null = nunca lo ha visto.
  lastSeenFeedbackAt DateTime?

  // Última vez que este usuario revisó sus propios roles de pago — usado para el
  // contador de "sin leer" en el sidebar. Null = nunca lo ha visto.
  lastSeenPayStubAt DateTime?

  snoozeUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examScores                                   ExamScore[]
  milestones                                   Milestone[]
  ackUpdates                                   UserAckUpdate[]
  suppliersCreated                             Supplier[]                         @relation("SupplierCreatedBy")
  suppliersApproved                            Supplier[]                         @relation("SupplierApprovedBy")
  supplierBankAccountsCreated                  SupplierBankAccount[]              @relation("SupplierBankAccountCreatedBy")
