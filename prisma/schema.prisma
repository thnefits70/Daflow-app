model Milestone {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String
  note   String?
  date   DateTime @default(now())

  @@index([userId])
}

/**
 * ---------------- Recordatorios periódicos ----------------
 */
// Confirmado 2026-07-23: disponible para todas las áreas (no exclusivo de
// una sola, a diferencia de Pagos recordatorios). Mismo permiso que
// Procesos/Documentos/Exámenes en esa área — admin edita, el líder solo ve.
enum PeriodicReminderRecurrence {
  DAILY
  WEEKLY
  ONCE
}

// Confirmado 2026-07-28: ya no es "el líder crea para su equipo" —
// cualquier persona en Nómina puede crear sus propios recordatorios
// personales (createdById), en cualquier área. Admin o el líder del área
// conservan permiso de gestionar TODOS los de esa área (igual que antes),
// pero cada quien además puede gestionar los suyos propios sin ser líder.
// createdById nulo = creado por admin (admin no es una fila real de User,
// mismo patrón que completedById). notifyPush es el interruptor individual
// por recordatorio para la notificación push — a diferencia de "Pendientes"
// (que usa categorías fijas), aquí cada recordatorio decide el suyo.
model PeriodicReminder {
  id          String                     @id @default(cuid())
  deptId      String
  department  Department                 @relation(fields: [deptId], references: [id], onDelete: Cascade)
  title       String
  detail      String                     @default("")
  recurrence  PeriodicReminderRecurrence
  weekdays    Int[]                      @default([]) // 1-6 (ISO, lunes=1, sábado=6) — solo para WEEKLY, uno o varios días
  date        DateTime? // fecha exacta — solo para ONCE
  timeOfDay   String? // "HH:MM" opcional — desde qué hora del día debe aparecer
  isActive    Boolean                    @default(true)
  order       Int                        @default(0)
  createdAt   DateTime                   @default(now())
  createdById String?
  createdBy   User?                      @relation("PeriodicReminderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notifyPush  Boolean                    @default(false)

  completions PeriodicReminderCompletion[]

  @@index([deptId])
  @@index([createdById])
}

model PeriodicReminderCompletion {
  id            String           @id @default(cuid())
  reminderId    String
  reminder      PeriodicReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  // DAILY: "YYYY-MM-DD" del día · WEEKLY: "YYYY-Www" de esa semana · ONCE: "once" (una sola vez, para siempre)
  period        String
  completedAt   DateTime         @default(now())
  completedById String?
  completedBy   User?            @relation("PeriodicReminderCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([reminderId, period])
  @@index([reminderId])
}

/**
 * ---------------- Procesos (flujograma) ----------------
 */
model Process {
  id          String     @id @default(cuid())
  deptId      String
  department  Department @relation(fields: [deptId], references: [id], onDelete: Cascade)
  title       String
  description String     @default("")
  sketchUrl   String?
  sketchName  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  flowSteps   FlowStep[]
  updates     ProcessUpdate[]
  questionSet ContentQuestionSet?

  @@index([deptId])
}

enum FlowStepType {
  START
  END
  PROCESS
  DECISION
  IO
  SUBPROCESS
  DOCUMENT
  PREPARE
  STORAGE
  CONNECTOR
  CHECKLIST
}

model FlowStep {
  id        String       @id @default(cuid())
  processId String
  process   Process      @relation(fields: [processId], references: [id], onDelete: Cascade)
  order     Int          @default(0)
  type      FlowStepType @default(PROCESS)
  label     String
  detail    String       @default("")

  // Solo para type = DOCUMENT: PDF adjunto al bloque
  fileUrl  String?
  fileName String?

  // React Flow canvas position, saved so the editor restores exact layout
  positionX Float @default(0)
  positionY Float @default(0)

  branches       FlowBranch[]            @relation("StepBranches")
  incomingBranch FlowBranch[]            @relation("StepTarget")
  checklistItems FlowStepChecklistItem[]

  @@index([processId])
}

// Solo para type = CHECKLIST: puntos de verificación propios de ese bloque del flujo
model FlowStepChecklistItem {
  id     String   @id @default(cuid())
  stepId String
  step   FlowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  text   String
  order  Int      @default(0)

  @@index([stepId])
}

model FlowBranch {
  id           String    @id @default(cuid())
  stepId       String
  step         FlowStep  @relation("StepBranches", fields: [stepId], references: [id], onDelete: Cascade)
  label        String    @default("")
  targetStepId String?
  targetStep   FlowStep? @relation("StepTarget", fields: [targetStepId], references: [id], onDelete: SetNull)

  // Qué lado del símbolo se usó para dibujar la conexión (top/right/bottom/left)
  sourceHandle String?
  targetHandle String?

  @@index([stepId])
}

model ProcessUpdate {
  id        String   @id @default(cuid())
  processId String
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  // Qué cambió, para el historial visible del proceso — obligatorio al notificar.
  note      String   @default("")
  createdAt DateTime @default(now())

  acks UserAckUpdate[]

  @@index([processId])
}

model UserAckUpdate {
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  updateId String
  update   ProcessUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  ackedAt  DateTime      @default(now())

  @@id([userId, updateId])
}

/**
 * ---------------- Módulos (empresa entera, admin: contenido + examen opcional) ----------------
 */
// Confirmado 2026-07-25: reemplaza el enfoque de sección única "Misión y
// Visión" — el admin crea tantos módulos como quiera (Misión y Visión,
// Manual de operaciones, etc.), cada uno con imagen de portada, uno o más
// documentos/PDFs/enlaces (mismo modelo Document, vía moduleId) y un examen
// opcional (mismo modelo Exam, vía moduleId) para verificar comprensión.
model Module {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String?
  imageName String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents   Document[]
  exam        Exam?
  questionSet ContentQuestionSet?

  @@index([order])
}

/**
 * ---------------- Documentos (por área, Leyes y Reglamentos con deptId nulo, o dentro de un módulo) ----------------
 */
model Document {
  id         String      @id @default(cuid())
  deptId     String?
  department Department? @relation(fields: [deptId], references: [id], onDelete: Cascade)
  isLaw      Boolean     @default(false)
  moduleId   String?
  module     Module?     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title      String
  content    String      @default("")
  link       String      @default("")
  fileUrl    String?
  fileName   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  questionSet ContentQuestionSet?

  @@index([deptId])
  @@index([isLaw])
  @@index([moduleId])
}

/**
 * ---------------- Exámenes (por área, o dentro de un módulo) ----------------
 */
model Exam {
  id         String      @id @default(cuid())
  // Exactamente uno de deptId/moduleId está presente — un examen de área
  // (como antes) o el único examen opcional de un módulo, nunca ambos.
  deptId     String?
  department Department? @relation(fields: [deptId], references: [id], onDelete: Cascade)
  moduleId   String?     @unique
  module     Module?     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title      String
  createdAt  DateTime    @default(now())

  questions ExamQuestion[]
  scores    ExamScore[]

  @@index([deptId])
}

model ExamQuestion {
  id           String   @id @default(cuid())
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  text         String
  options      String[]
  correctIndex Int
  order        Int      @default(0)

  @@index([examId])
}

model ExamScore {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  score     Int
  total     Int
  createdAt DateTime @default(now())

  @@index([examId])
  @@index([userId])
}

/**
 * ---------------- KPIs financieros (histórico mensual por operación) ----------------
 */
// Catálogo de operaciones/marcas dentro de un departamento (hoy solo lo usa
// Finanzas y Contabilidad): Provedix, Importadora Damián, e Importadora
// Shanghai (todavía inactiva). Activar una operación nueva es un simple
// UPDATE de isActive, no una migración.
model FinanceOperation {
  id         String     @id @default(cuid())
  deptId     String
  department Department @relation(fields: [deptId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())

  records FinanceKpiRecord[]

  @@unique([deptId, name])
  @@index([deptId])
}

// Un registro por operación por mes: los 7 datos crudos que arman el estado
// de resultados. Utilidad bruta/operativa/neta y márgenes se calculan
// siempre en el servidor a partir de estos campos — nunca se guardan acá —
// para no repetir el problema de fórmulas rotas del Excel original. ROI se
// captura directo, todavía sin un monto de inversión que lo derive.
model FinanceKpiRecord {
  id          String           @id @default(cuid())
  deptId      String
  department  Department       @relation(fields: [deptId], references: [id], onDelete: Cascade)
  operationId String
  operation   FinanceOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  // Mes al que corresponde el registro, formato "YYYY-MM"
  period String

  // Confirmado 2026-07-29: el ROI ya NO se tipea a mano — se calcula
  // (utilidad neta ÷ costo de ventas) en src/lib/financeKpisCalc.ts
  // (computeDerived) a partir de estos mismos campos, así que no hace falta
  // guardarlo aparte.
  ventas            Float
  costoVentas       Float
  gastosVenta       Float
  gastosAdmin       Float
  otrosIngresos     Float
  gastosFinancieros Float
  otrosGastos       Float

  // Quién subió/corrigió este registro por última vez — null si lo hizo el
  // admin directamente (su sesión no tiene un User real, igual que PayStub).
  uploadedById String?
  uploadedBy   User?   @relation("FinanceKpiRecordUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([operationId, period])
  @@index([deptId])
  @@index([operationId])
}

// Saldos compartidos de TODA la operación al cierre del mes — inventario,
// cuentas por cobrar y cuentas por pagar son de la empresa completa, no se
// reparten por marca (Provedix e Importadora Damián comparten bodega,
// cartera y proveedores). Alimentan días de inventario/cartera/proveedores
// y el ciclo de conversión de efectivo, siempre calculados en Consolidado.
model FinanceSharedMonthlyBalance {
  id         String     @id @default(cuid())
  deptId     String
  department Department @relation(fields: [deptId], references: [id], onDelete: Cascade)

  period String // "YYYY-MM"

  inventarioFinal  Float?
  cuentasPorCobrar Float?
  cuentasPorPagar  Float?

  // Confirmado 2026-08-05: cuando Daniel (líder de Inventario) sube el
  // inventario del mes desde "Control de Inventario", puede adjuntar una
  // captura donde se vea ese valor — la IA lee el monto de la foto y lo
  // compara contra lo que escribió (mismo patrón que Caja Chica), como
  // respaldo adicional de que el número es real, no solo la confirmación
  // manual que ya se le pide antes de guardar.
  inventarioProofUrl     String?
  inventarioAiReadAmount Float?
  inventarioAiMatches    Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deptId, period])
  @@index([deptId])
}

// Confirmado 2026-08-05: reemplaza por completo el seguimiento manual
// anterior (InventoryStaleProduct, nunca llegó a usarse) — cada mes Daniel
// sube el mismo Excel de saldos costeados/valorizados (código, costo
// promedio, descripción, stock actual) en vez de escribir a mano qué
// productos no se venden. "Sin movimiento" se deriva solo comparando el
// stock de cada producto contra el mes inmediatamente anterior — si NO bajó,
// cuenta como un mes más sin moverse (ver computeStaleStreaks en
// inventoryKpisCalc.ts). Reemplazar el mes (no agregar filas sueltas) es la
// única forma de corregir un error, igual que la plantilla de Finanzas.
model InventoryProductSnapshot {
  id         String     @id @default(cuid())
  deptId     String
  department Department @relation(fields: [deptId], references: [id], onDelete: Cascade)

  period      String // "YYYY-MM"
  productCode String
  description String
  avgCost     Float
  stock       Float
  costTotal   Float // avgCost * stock, calculado al momento de subir el archivo

  createdById String?
  createdBy   User?   @relation("InventoryProductSnapshotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deptId, period, productCode])
  @@index([deptId, period])
  @@index([productCode])
}

enum PettyCashBoxType {
  PRINCIPAL
  SECUNDARIA
}

enum PettyCashEntryKind {
  DESEMBOLSO
  RECARGA
}

// Confirmado 2026-08-05: dos cajas — Principal (Nairoby escribe) y
// Secundaria (Bryan Ríos escribe, vive en su propia "Mi área de trabajo",
// bajo el mando de la Principal — Nairoby la ve pero no escribe en ella).
model PettyCashBox {
  id           String           @id @default(cuid())
  type         PettyCashBoxType @unique
  minThreshold Float            @default(10)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  entries       PettyCashEntry[]
  exceptions    PettyCashFreightException[]
  payoutAccount PettyCashPayoutAccount?
}

// Cuenta donde quien administra la caja (nunca admin) quiere recibir el
// fondeo — mismos campos que EmployeeBankAccount/SupplierBankAccount, más
// correo/celular opcionales (algunos bancos en Ecuador transfieren solo con
// el número de celular registrado). La fija exclusivamente esa persona, así
// el dueño sabe a qué cuenta transferir en vez de adivinar (2026-08-19).
model PettyCashPayoutAccount {
  id    String       @id @default(cuid())
  boxId String       @unique
  box   PettyCashBox @relation(fields: [boxId], references: [id], onDelete: Cascade)

  bankName          String
  bankAccountType   String
  bankAccountNumber String
  bankAccountHolder String
  holderIdType      HolderIdType?
  holderIdNumber    String?
  email             String?
  phone             String?

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Un registro por movimiento (desembolso o recarga) — nunca se elimina,
// solo se archiva (confirmado 2026-08-05, para que ninguna evidencia pueda
// borrarse por mal uso o manipulación). El saldo de la caja se calcula
// siempre a partir de las filas NO archivadas.
model PettyCashEntry {
  id            String             @id @default(cuid())
  boxId         String
  box           PettyCashBox       @relation(fields: [boxId], references: [id], onDelete: Cascade)
  kind          PettyCashEntryKind
  // Confirmado 2026-08-05: UN SOLO contador para las dos cajas (no uno por
  // caja) — nunca se repite ni se reinicia entre Principal y Secundaria.
  // Autoincrement de Postgres, así que nunca hay dos solicitudes con el
  // mismo número aunque lleguen al mismo tiempo. El código legible que se
  // le muestra a la persona (ej. "CC-P-003") se arma con esto + box.type,
  // ver formatPettyCashCode() en src/lib/pettyCash.ts.
  requestNumber Int                @unique @default(autoincrement())

  amount      Float
  description String

  proofUrl     String?
  proofHash    String?
  aiReadAmount Float?
  aiMatches    Boolean?

  // Desembolso — vínculo con una orden de compra (groupId de
  // PurchaseRequest) o, como última opción, un motivo manual.
  linkedGroupId String?
  manualReason  String?

  // Recarga — no se acredita al saldo hasta que quien la recibe confirma.
  // Mientras confirmedAt sea null, la persona queda bloqueada para crear
  // desembolsos/excepciones en su propia caja (chequeado en el guard, no
  // aquí). fundingReminderSentAt evita mandar el aviso más de una vez.
  confirmedAt           DateTime?
  confirmedById         String?
  confirmedBy           User?     @relation("PettyCashEntryConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  fundingReminderSentAt DateTime?

  archived     Boolean   @default(false)
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("PettyCashEntryArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  restoredAt   DateTime?
  restoredById String?
  restoredBy   User?     @relation("PettyCashEntryRestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("PettyCashEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("PettyCashEntryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boxId])
  @@index([linkedGroupId])
}

// Confirmado 2026-08-05: si una orden de compra ya tiene flete pagado (por
// cualquier canal — transferencia o caja chica) y de verdad hace falta un
// segundo pago real, Bryan explica el motivo y el dueño aprueba/rechaza
// antes de habilitar la segunda carga.
model PettyCashFreightException {
  id      String       @id @default(cuid())
  boxId   String
  box     PettyCashBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  groupId String

  reason String
  status String @default("pending") // "pending" | "approved" | "rejected"

  requestedById String?
  requestedBy   User?     @relation("PettyCashExceptionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    User?     @relation("PettyCashExceptionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([boxId])
  @@index([groupId])
}

// Historial de cargas — quién subió qué mes y cuándo, y si reemplazó
// (corrigió) un mes que ya existía. Alimenta "Cargas recientes".
model FinanceKpiUpload {
  id         String     @id @default(cuid())
  deptId     String
  department Department @relation(fields: [deptId], references: [id], onDelete: Cascade)

  period String // "YYYY-MM"

  uploadedById String?
  uploadedBy   User?   @relation("FinanceKpiUploadUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  fileUrl  String?
  fileName String?

  // true si este mes ya tenía información y esta carga la reemplazó.
  isCorrection Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([deptId])
  @@index([period])
}

// Metas de margen, bandas de ROI, y tasa de impuesto — un registro por
// departamento, editable desde el dashboard (ej. el campito de tasa de
// impuesto). Valores por defecto ya confirmados por el admin para Finanzas
// y Contabilidad.
model FinanceKpiSettings {
  id         String     @id @default(cuid())
  deptId     String     @unique
  department Department @relation(fields: [deptId], references: [id], onDelete: Cascade)

  // Confirmado 2026-07-28: margen bruto/operativo usan el mismo esquema de
  // bandas absolutas que margen neto (ya no "distancia a una sola meta"):
  // <targetMargenX alerta, hasta excelenteMargenX saludable, por encima
  // excelente. Valores calculados por el asistente en base a los meses
  // reales ya cargados (ene-may 2026) y aprobados por el admin — fijos, sin
  // campo editable en la UI (a diferencia de la tasa de impuesto).
  targetMargenBruto        Float @default(30)
  excelenteMargenBruto     Float @default(40)
  targetMargenOperativo    Float @default(20)
  excelenteMargenOperativo Float @default(30)
  targetMargenNeto         Float @default(20)
  excelenteMargenNeto      Float @default(30)

  // Confirmado 2026-07-22: <roiBandRed malo, hasta roiBandYellow regular,
  // hasta roiBandExcellent saludable, por encima excelente — mismo patrón de
  // 4 niveles que excelenteMargenNeto.
  roiBandRed       Float @default(15)
  roiBandYellow    Float @default(20)
  roiBandTarget    Float @default(20)
  roiBandExcellent Float @default(45)

  taxRatePct Float @default(25)

  // Confirmado 2026-07-27: % de crecimiento esperado mes a mes para Ventas
  // totales — la meta del mes en curso se calcula como (ventas del mes
  // anterior real) × (1 + este % / 100), no un valor fijo por mes.
  targetMonthlyGrowthPct Float @default(10)

  updatedAt DateTime @updatedAt
}

// Pagos mensuales variados (suscripciones, servicios, tarjetas...) que se
// dan de alta/baja con el tiempo — confirmado 2026-07-22, solo Finanzas y
// Contabilidad por ahora. `amount` es un monto de referencia que se queda
// fijo mes a mes (editable en cualquier momento si sube/baja de verdad) —
// distinto del monto real registrado en PaymentReminderRecord.amountPaid,
// que se precarga con esta referencia pero se puede ajustar sin tocarla,
// para el mes puntual en que varíe.
model PaymentReminder {
  id               String     @id @default(cuid())
  deptId           String
  department       Department @relation(fields: [deptId], references: [id], onDelete: Cascade)
  name             String // empresa/plataforma a la que se paga
  amount           Float? // monto de referencia, editable, no cambia solo
  paymentMethod    String?
  dueDay           Int // día del mes de vencimiento (1-31, se recorta al último día real del mes)
  reminderStartDay Int // día del mes desde el cual empieza a aparecer en pendientes
  isActive         Boolean    @default(true)
  order            Int        @default(0)
  createdAt        DateTime   @default(now())

  records PaymentReminderRecord[]

  @@index([deptId])
}

model PaymentReminderRecord {
  id            String          @id @default(cuid())
  reminderId    String
  reminder      PaymentReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  period        String // "YYYY-MM"
  amountPaid    Float
  completedById String?
  completedBy   User?           @relation("PaymentReminderCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime        @default(now())

  @@unique([reminderId, period])
  @@index([reminderId])
}

/**
 * ---------------- Servicio Postventa (feedback de tiendas) ----------------
 */
// Confirmado 2026-07-22: Nairoby (líder de Finanzas y Contabilidad) contacta
// tiendas y registra feedback sin fecha fija — no es un KPI mensual, es un
// registro por llamada. Fulfillment e Inventario pueden VER los resultados
// (no editar) porque muchos problemas que reporta una tienda vienen de ahí.
model Store {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  contactPhone String?
  // Confirmado 2026-07-25: a qué marca/bodega pertenece esta tienda —
  // mismos 3 nombres que el catálogo de operaciones de Finanzas, pero es un
  // campo simple aquí (no FK) porque Servicio Postventa vive en Análisis de
  // Mercado, un dominio distinto. Solo 3 valores conocidos, cambian rara vez.
  brand        String?
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  evaluations StoreFeedbackEvaluation[]

  @@index([order])
}

model StoreFeedbackEvaluation {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // "YYYY-MM" — el mes que se está evaluando (no la fecha de la llamada).
  // Confirmado 2026-07-22: se hace la 2da semana del mes, miércoles a
  // viernes, evaluando el mes anterior — igual patrón que los demás KPIs
  // mensuales de Finanzas.
  period String

  // "¿Qué tan probable es que sigas comprándonos?" — 1-5 (confirmado
  // 2026-07-25: mismo rango que los demás indicadores, 5 = excelente).
  loyaltyScore Int

  // Los 5 pilares que explican el porqué de ese resultado, 1-5 cada uno.
  // "Disponibilidad de stock" se eliminó (confirmado 2026-07-25). El campo
  // sigue llamándose qualityScore por compatibilidad, pero desde 2026-07-25
  // representa "Gestión de garantías", no "Calidad del producto".
  fulfillmentScore     Int
  qualityScore         Int
  responseTimeScore    Int
  commercialTermsScore Int
  communicationScore   Int

  comment       String   @default("")
  // Confirmado 2026-07-24: enfoque de retención — qué se va a hacer para
  // fortalecer la relación (no solo el diagnóstico) y qué necesita la tienda
  // de nosotros para crecer (más stock, apoyo creativo para Meta/TikTok,
  // mejores tiempos, etc.). El semáforo de riesgo se deriva de loyaltyScore,
  // no necesita su propio campo.
  actionPlan    String   @default("")
  growthNeeds   String   @default("")
  evaluatedById String?
  evaluatedBy   User?    @relation("StoreFeedbackEvaluatedBy", fields: [evaluatedById], references: [id], onDelete: SetNull)
  evaluatedAt   DateTime @default(now())

  @@index([storeId])
  @@index([period])
}

/**
 * ---------------- Métrica semanal (ej. pedidos despachados de Fulfillment) ----------------
 */
model WeeklyMetricRecord {
  id         String     @id @default(cuid())
  deptId     String
  department Department @relation(fields: [deptId], references: [id], onDelete: Cascade)

  // Semana ISO, formato "YYYY-Www" (lo que entrega <input type="week">)
  week  String
  value Int

  // Pedidos que quedaron sin despachar esa semana (opcional), usado para
  // calcular el Fill Rate: value / (value + notDispatched) * 100.
  // Confirmado 2026-07-28: desde que existen las 3 columnas de abajo,
  // notDispatched pasa a ser la SUMA de esas 3 (se sigue guardando para no
  // romper el historial viejo, que nunca tuvo el desglose). Las semanas
  // ya cargadas antes de este cambio se quedan tal cual, sin desglose.
  notDispatched Int?

  // Desglose de Fill Rate — confirmado 2026-07-28, ver boceto aprobado.
  // prepared: empacada y etiquetada pero no entregada al courier ese día.
  // generated: la guía/etiqueta ya existe pero el producto no se empacó.
  // outOfStock: no se pudo ni preparar por falta de mercadería.
  prepared   Int?
  generated  Int?
  outOfStock Int?

  // Confirmado 2026-08-31: si el Fill Rate de la semana queda por debajo de
  // 95%, el líder de Fulfillment (hoy Yair) explica al equipo qué pasó —
  // visible para todos en Inicio, no solo un mensaje privado al admin.
  // fillRateJustificationBy guarda el nombre de quien la escribió al
  // momento de guardar (no una referencia a User) para no depender de que
  // esa persona siga activa/con ese rol más adelante.
  fillRateJustification   String?
  fillRateJustificationBy String?
  fillRateJustificationAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deptId, week])
  @@index([deptId])
}

enum ReviewStatus {
  PENDING
  RESOLVED
  REJECTED
}

/**
 * ---------------- Feedback semanal (reunión admin-líder: problemas y plan de acción) ----------------
 */
model WeeklyReviewRecord {
  id         String     @id @default(cuid())
  deptId     String
  department Department @relation("WeeklyReviewDept", fields: [deptId], references: [id], onDelete: Cascade)

  // Semana ISO, formato "YYYY-Www" (lo que entrega <input type="week">)
  week       String
  problem    String
  actionPlan String
  status     ReviewStatus @default(PENDING)

  // De dónde salió este registro: escrito a mano por el admin, o generado
  // por el asistente de check-in semanal a partir de lo que reportó el
  // propio empleado (ver CheckinConversation / src/lib/weeklyCheckin.ts).
  source       ReviewSource @default(ADMIN_MANUAL)
  reportedById String?
  reportedBy   User?        @relation("WeeklyReviewReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)

  // Cuando el plan de acción depende de otra área o de un colaborador
  // específico de otro equipo — el asistente intenta resolverlo a un FK
  // real por nombre; involvesRaw guarda el texto crudo aunque no se logre
  // resolver, para que el admin no pierda la mención. involvedNotifiedAt
  // queda null si no aplica o si no había líder activo a quien avisar.
  involvesDeptId     String?
  involvesDept       Department? @relation("WeeklyReviewInvolvesDept", fields: [involvesDeptId], references: [id], onDelete: SetNull)
  involvesUserId     String?
  involvesUser       User?       @relation("WeeklyReviewInvolvesUser", fields: [involvesUserId], references: [id], onDelete: SetNull)
  involvesRaw        String?
  involvedNotifiedAt DateTime?

  // Qué hizo realmente el líder para resolverlo — solo Mary la llena, al
  // llamar close_previous_report (nunca un simple cambio de estado sin
  // explicación). Null mientras sigue Pendiente o si el admin lo cerró a
  // mano desde su propio CRUD.
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deptId])
  @@index([reportedById])
  @@index([involvesDeptId])
}

enum ReviewSource {
  ADMIN_MANUAL
  ASSISTANT
}

enum SupplierStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * ---------------- Proveedores (directorio con aprobación del líder) ----------------
 */
enum SupplierType {
  SUPPLIER
  CARRIER
}

enum HolderIdType {
  RUC
  CEDULA
}

enum ShippingPaymentTiming {
  WITH_PURCHASE
  ON_DELIVERY
}

model Supplier {
  id          String       @id @default(cuid())
  // Confirmado 2026-07-30: los transportistas de Control de Compras viven en
  // esta MISMA tabla (type=CARRIER) en vez de un catálogo aparte, para que
  // "se sincroniza con Proveedores" sea automático (una sola fila, nunca dos
  // registros del mismo contacto) — se distinguen y filtran por type, y un
  // transportista simplemente no pide location (no tiene local fijo).
  type        SupplierType @default(SUPPLIER)
  name        String
  location    String?
  // Pin exacto marcado en el mapa (OpenStreetMap), opcional — más confiable que
  // una dirección escrita para que alguien nuevo pueda llegar.
  locationLat Float?
  locationLng Float?
  category    String?
  notes       String?

  email String?

  status       SupplierStatus @default(PENDING)
  rejectReason String?

  // Quién lo propuso y en qué área estaba en ese momento — se guarda aparte del
  // usuario para que la aprobación siga funcionando aunque luego se elimine o se
  // cambie de área a quien lo creó. Null cuando lo crea el admin directamente.
  createdById     String?
  createdBy       User?   @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByDeptId String?

  approvedById String?
  approvedBy   User?     @relation("SupplierApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts                   SupplierContact[]
  channels                   SupplierChannel[]
  purchaseRequestsAsSupplier PurchaseRequest[]         @relation("PurchaseRequestSupplier")
  purchaseRequestsAsCarrier  PurchaseRequest[]         @relation("PurchaseRequestCarrier")
  bankAccounts               SupplierBankAccount[]
  credits                    SupplierCredit[]
  merchandiseOutflowBatches  MerchandiseOutflowBatch[]

  @@index([status])
  @@index([createdByDeptId])
  @@index([type])
}

// Confirmado 2026-08-03: un proveedor puede tener varias cuentas bancarias
// (cambia de banco, o pide que se le pague en una nueva cuenta) — se
// agregan, nunca se editan, y solo el administrador principal puede
// eliminarlas (con confirmación), para que el historial de a qué cuenta se
// le pagó en el pasado no se pierda ni se pueda alterar por accidente.
model SupplierBankAccount {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  bankName          String
  bankAccountType   String
  bankAccountNumber String
  bankAccountHolder String
  // Confirmado 2026-08-03: para transferencias hace falta saber si el
  // titular se identifica con RUC (empresa) o cédula (persona natural) —
  // opcional a nivel de columna porque las cuentas migradas antes de este
  // campo no lo tienen, pero se pide siempre al registrar una cuenta nueva.
  holderIdType      HolderIdType?
  holderIdNumber    String?

  createdById String?
  createdBy   User?    @relation("SupplierBankAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  purchaseRequests                 PurchaseRequest[]
  purchaseRequestsAsCarrierAccount PurchaseRequest[] @relation("PurchaseRequestCarrierBankAccount")

  @@index([supplierId])
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // Ej. "Asesor Juan", "Ventas" — a quién corresponde este WhatsApp dentro de la empresa
  label    String
  whatsapp String

  @@index([supplierId])
}

// Enlace a otro canal del proveedor (Telegram, Instagram, Facebook, etc.) —
// hacer clic abre el enlace directamente.
model SupplierChannel {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // "TELEGRAM" | "INSTAGRAM" | "FACEBOOK" | "OTHER"
  platform String
  url      String

  @@index([supplierId])
}

/**
 * ---------------- Control de Compras ----------------
 */
// Confirmado 2026-07-30 (boceto aprobado): reemplaza el grupo de WhatsApp
// para pedir aprobación de pago. Un nombre por insumo, siempre — el
// historial de precio depende de que nunca se parta en dos.
model PurchaseCatalogItem {
  id          String   @id @default(cuid())
  name        String   @unique
  // 1 a 3 fotos (real si se tiene físicamente, referencial del proveedor si
  // no) — para que Inventario y Finanzas identifiquen el producto sin adivinar.
  photos      String[]
  // Opcional — confirmado 2026-07-30: breve descripción de qué es/hace el
  // producto, para ayudar a identificarlo (no obligatoria, a diferencia de
  // Proveedores.notes).
  description String?
  // Opcional — confirmado 2026-07-31: código/SKU que el proveedor usa para
  // este producto. Algunas cotizaciones no traen el nombre, solo un código —
  // si ya lo tenemos guardado aquí, se reconoce solo en vez de tener que
  // confirmarlo a mano cada vez.
  code        String?

  // Confirmado 2026-08-21: código del producto en el sistema Just (distinto
  // de `code`, que es el SKU del proveedor) — clave real de la "Base de
  // datos de productos" importada desde el export de Just (ver
  // JustCatalogImport). Único porque en Just cada código es un producto.
  justCode String? @unique

  // true SOLO en los renglones "esqueleto" que crea la importación de Just
  // para un producto que todavía no existe en DAFLOW (código+nombre
  // conocidos, sin fotos). No selecionable en los pickers de Compras/
  // Reingreso hasta que alguien lo "matricule" (mínimo 3 fotos reales o de
  // referencia del proveedor — ver complete-registration). Nunca se
  // recalcula retroactivamente sobre productos ya existentes creados antes
  // de esta regla, aunque tengan menos de 3 fotos.
  pendingRegistration Boolean @default(false)

  createdById String?
  createdBy   User?    @relation("PurchaseCatalogItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  requests      PurchaseRequest[]
  deleteRequest PurchaseCatalogItemDeleteRequest?

  // Confirmado 2026-08-19: Reingreso de Mercadería reusa este mismo catálogo
  // — un producto puede quedar registrado aquí sea porque alguien lo dio de
  // alta para Control de Compras, porque quedó confirmado desde un
  // reingreso, o porque vino de la importación de Just.
  merchandiseReentryItems        MerchandiseReentryItem[]
  // Confirmado 2026-08-25: Registro de Egresos (despacho/garantía/deterioro)
  // reusa este mismo catálogo compartido.
  merchandiseOutflowItems        MerchandiseOutflowItem[]
  // Confirmado 2026-08-25: Ventas Externas (Fase 3) también reusa este
  // catálogo compartido.
  externalSales                  ExternalSale[]
  // Confirmado 2026-08-25: Guías Canceladas (Fase 4) también reusa este
  // catálogo compartido.
  cancelledGuideItems            CancelledGuideItem[]
  // Confirmado 2026-08-26: un producto real puede ser componente de uno o
  // más combos de Dropi (ver DropiCombo).
  dropiComboComponents           DropiComboComponent[]
  // Confirmado 2026-08-29: Compras Personales también reusa este catálogo
  // — el colaborador lo elige al declarar, Daniel lo reconfirma/relinkea al
  // aprobar bodega (dos relaciones separadas, mismo criterio que
  // employeeProductName/confirmedProductName).
  personalPurchaseItemsPicked    PersonalPurchaseItem[]   @relation("PersonalPurchaseItemCatalogItem")
  personalPurchaseItemsConfirmed PersonalPurchaseItem[]   @relation("PersonalPurchaseItemConfirmedCatalogItem")
  // Confirmado 2026-08-29: Ruptura de Stock (KPIs Generales) también reusa
  // este catálogo compartido.
  stockoutProduct                StockoutProduct?
}

// Confirmado 2026-08-26 (pedido explícito del usuario): un ID de combo de
// Dropi NO es un producto físico real — Dropi los crea con nombres
// distintos por tema publicitario (para atraer clientes), pero por dentro
// empaquetan varios productos reales de Just en cantidades fijas. Solo
// Daniel sabe cómo se desglosa cada combo (tribal knowledge real); una vez
// registrado acá, el lector de manifiestos de Registro de Egresos
// (readOutflowManifest) lo aplica solo cada vez que ese código aparece en
// una hoja de despacho/garantía, en vez de que Daniel tenga que
// desglosarlo a mano cada vez. Gestionado desde "Base de datos de
// productos" (mismo canManageJustCatalog: Daniel o admin).
model DropiCombo {
  id    String  @id @default(cuid())
  code  String  @unique
  // Nombre que usa Dropi para este combo — solo referencia, nunca se confía
  // en él para identificar el producto real (por eso existe este modelo).
  label String?

  createdById String?
  createdBy   User?    @relation("DropiComboCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  components DropiComboComponent[]
}

model DropiComboComponent {
  id      String     @id @default(cuid())
  comboId String
  combo   DropiCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  catalogItemId String
  catalogItem   PurchaseCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  // Cuántas unidades de este producto real vienen en 1 unidad despachada
  // de este combo.
  quantity Int

  @@index([comboId])
  @@index([catalogItemId])
}

// Registro de auditoría de cada vez que Daniel sube el export de Just —
// también sirve para mostrar "última actualización" en la pestaña Base de
// datos de productos. Confirmado 2026-08-21: exclusivo de Daniel (líder de
// Inventario), ni siquiera admin.
model JustCatalogImport {
  id           String   @id @default(cuid())
  importedById String?
  importedBy   User?    @relation("JustCatalogImportImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  importedAt   DateTime @default(now())

  totalRows    Int
  createdCount Int // productos nuevos creados como esqueleto (pendientes de matricular)
  linkedCount  Int // productos existentes vinculados a un justCode por coincidencia de nombre
  renamedCount Int // productos ya vinculados cuyo nombre se actualizó al de Just en esta importación

  // Confirmado 2026-08-24: mismo nombre repetido 2+ veces en el propio
  // archivo de Just con códigos distintos — Daniel debe decidir por grupo
  // (mantener un solo código o confirmar que son productos distintos) antes
  // de poder aplicar. Se guardan los totales de cada subida para poder dar
  // seguimiento en el historial de si el duplicado real se sigue
  // repitiendo en Just (si Daniel no lo corrigió ahí, vuelve a aparecer en
  // la siguiente subida).
  duplicateGroupsTotal    Int @default(0)
  duplicateGroupsResolved Int @default(0)

  // Confirmado 2026-08-24: productos que ya tenían justCode vinculado pero
  // su código no apareció en ESTA subida — probablemente Just lo
  // descontinuó o le cambió el código sin que se note como "cambio de
  // nombre". No se borra ni se desvincula nada automáticamente, solo se
  // cuenta para que Daniel lo revise (ver missingItems en
  // classifyJustCatalogRows).
  missingCount Int @default(0)

  @@index([importedAt])
}

// La sola existencia de esta fila ES el estado "pendiente de eliminar" —
// @unique en itemId impide dos
// solicitudes a la vez sobre el mismo insumo. Se borra al rechazar; al
// aprobar, se borra junto con el insumo (ver ruta de aprobación).
model PurchaseCatalogItemDeleteRequest {
  id     String              @id @default(cuid())
  itemId String              @unique
  item   PurchaseCatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  reason        String?
  requestedById String?
  requestedBy   User?    @relation("PurchaseCatalogItemDeleteRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt   DateTime @default(now())
}

// Confirmado 2026-08-29: pedido explícito del usuario — se quitó la opción
// de "escribir el nombre a mano" en los buscadores de producto (ya no tiene
// sentido con el catálogo sincronizado desde Just), pero la sincronización
// es manual (alguien sube el export cada cierto tiempo) así que puede pasar
// que un producto real todavía no esté cargado. En vez de dejar a la
// persona sin ninguna salida, puede avisarle a quien administra el
// catálogo (Daniel/admin, ver canManageJustCatalog) — queda registrado acá
// y notificado por campanita, sin bloquear con un nombre libre inventado.
model CatalogMissingReport {
  id    String  @id @default(cuid())
  query String
  note  String?

  reportedById String
  reportedBy   User     @relation("CatalogMissingReportReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)
  reportedAt   DateTime @default(now())

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("CatalogMissingReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
}

enum PurchaseRequestStatus {
  PENDING_APPROVAL
  REJECTED
  APPROVED
  PAID
  // Confirmado 2026-08-18: pedido explícito del usuario — la recepción física
  // ya no es exclusiva de Daniel (líder de Inventario), cualquiera de su
  // equipo puede recibir con foto+video. Este estado marca "el equipo ya
  // recibió, pendiente de que Daniel dé la aprobación final" — solo ahí pasa
  // a RECEIVED de verdad (ver PurchaseRequestReceipt.approvedAt).
  RECEIVED_PENDING_REVIEW
  RECEIVED
}

enum PurchasePaymentMethod {
  TRANSFER
  PETTY_CASH
}

enum PurchaseInvoiceStatus {
  PENDING
  COMPLETE
  PARTIAL
  NON_FISCAL
  NONE
}

// Solicitud de compra — el corazón del módulo. deptId es el área de quien
// solicita (Bryan → Compras, Nairoby → Finanzas), para que la bandeja de
// admin y los reportes puedan filtrar por área si hace falta más adelante.
model PurchaseRequest {
  id            String     @id @default(cuid())
  // Confirmado 2026-07-31: una cotización suele traer varios productos —
  // todas las filas creadas desde el mismo envío comparten este groupId
  // (siempre poblado, incluso para una solicitud de un solo producto, para
  // no tener que ramificar la lógica de agrupar entre "con grupo"/"sin
  // grupo"). El total leído por IA se compara contra la SUMA de todas las
  // líneas del grupo, no una por una.
  groupId       String
  // Confirmado 2026-08-05: código correlativo (SC-001, SC-002...) para
  // control y la auditoría semestral — una sola numeración para todo el
  // módulo, compartida por todas las filas del mismo groupId (se asigna una
  // vez por grupo, no por fila). Null en solicitudes de antes de este cambio.
  requestNumber Int?
  deptId        String
  dept          Department @relation(fields: [deptId], references: [id], onDelete: Cascade)

  catalogItemId String
  catalogItem   PurchaseCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  supplierId String
  supplier   Supplier @relation("PurchaseRequestSupplier", fields: [supplierId], references: [id], onDelete: Restrict)

  // Confirmado 2026-08-03: a qué cuenta bancaria del proveedor se le paga —
  // relevante cuando el proveedor tiene varias. Null si en ese momento solo
  // tenía una (no hacía falta elegir) o si la cuenta elegida se borró después.
  bankAccountId String?
  bankAccount   SupplierBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  // Confirmado 2026-08-06: si al momento de pagar la cuenta elegida no
  // funciona (datos mal, banco rechaza la transferencia), admin pide con un
  // clic que quien solicitó cambie o elija otra cuenta — se limpia solo en
  // cuanto esa persona vuelve a elegir una cuenta para esta solicitud.
  bankAccountChangeRequestedAt   DateTime?
  bankAccountChangeNote          String?
  bankAccountChangeRequestedById String?
  bankAccountChangeRequestedBy   User?     @relation("PurchaseRequestBankAccountChangeRequestedBy", fields: [bankAccountChangeRequestedById], references: [id], onDelete: SetNull)

  quantity  Int
  unitCost  Float
  totalCost Float

  // Cotización — verificada por IA una sola vez por solicitud (no es un chat).
  quoteImageUrl      String
  quoteReadTotal     Float?
  // Cuando la cotización solo trae un código de proveedor, no el nombre del
  // producto — la persona confirma manualmente a qué insumo corresponde.
  quoteReferenceCode String?
  quoteConfirmedAt   DateTime?
  // Confirmado 2026-07-31: cuando la cotización solo trae código (no nombre
  // de producto), la orden de compra es obligatoria como respaldo de qué se
  // está comprando — impuesta en la ruta, no aquí; opcional en cualquier
  // otro caso (se puede subir por adelantado igual).
  purchaseOrderUrl   String?

  shippingIncluded                  Boolean                @default(false)
  // Confirmado 2026-08-11: pedido explícito del usuario — a veces al
  // solicitar todavía no se sabe ni el transportista ni el costo real del
  // flete (se sabrá más cerca de la entrega). Con esto en true, carrierId y
  // shippingCostTotal quedan vacíos a propósito (no por error) y
  // shippingPaymentTiming se fuerza a ON_DELIVERY — aparece como pendiente
  // en "Mis solicitudes" hasta que se complete con el transportista y costo
  // reales (mismo patrón que purchaseOrderUrl, que también se completa
  // después).
  shippingCarrierPending            Boolean                @default(false)
  carrierId                         String?
  carrier                           Supplier?              @relation("PurchaseRequestCarrier", fields: [carrierId], references: [id], onDelete: SetNull)
  shippingCostTotal                 Float?
  shippingPaymentMethod             PurchasePaymentMethod?
  // Confirmado 2026-08-03: cuando el flete se cobra aparte, se elige si se
  // paga junto con la compra (como ya funcionaba) o si queda pendiente hasta
  // que llegue la mercadería — algunos transportistas solo dan sus datos
  // bancarios al entregar, así que la cuenta del transportista se puede
  // agregar/elegir después, no necesariamente al solicitar.
  shippingPaymentTiming             ShippingPaymentTiming?
  carrierBankAccountId              String?
  carrierBankAccount                SupplierBankAccount?   @relation("PurchaseRequestCarrierBankAccount", fields: [carrierBankAccountId], references: [id], onDelete: SetNull)
  shippingPaymentRequestedAt        DateTime?
  shippingPaymentRequestedById      String?
  shippingPaymentRequestedBy        User?                  @relation("PurchaseRequestShippingPaymentRequestedBy", fields: [shippingPaymentRequestedById], references: [id], onDelete: SetNull)
  shippingPaidAt                    DateTime?
  shippingPaidById                  String?
  shippingPaidBy                    User?                  @relation("PurchaseRequestShippingPaidBy", fields: [shippingPaidById], references: [id], onDelete: SetNull)
  shippingPaymentProofUrl           String?
  shippingPaymentProofReceiptNumber String?

  // Obligatoria solo cuando el costo por unidad superó el promedio de las
  // últimas 3 compras de este insumo — impuesta en la ruta, no aquí.
  justification String?

  status       PurchaseRequestStatus @default(PENDING_APPROVAL)
  rejectReason String?

  // Confirmado 2026-08-07: si una solicitud se rechaza, quien la pidió puede
  // corregir lo que faltó y reenviarla — cada reenvío crea un groupId nuevo
  // (nunca se edita el rechazado), y este campo apunta al groupId anterior
  // para armar la cadena. attemptNumber se calcula en el servidor a partir de
  // ese anterior (nunca confiado del cliente) — 1 = primer intento.
  attemptNumber          Int     @default(1)
  resubmittedFromGroupId String?

  requestedById     String?
  requestedBy       User?    @relation("PurchaseRequestRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedByDeptId String?
  requestedAt       DateTime @default(now())

  reviewedById String?
  reviewedBy   User?     @relation("PurchaseRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  paidAt                    DateTime?
  paidById                  String?
  paidBy                    User?     @relation("PurchaseRequestPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paymentProofUrl           String?
  // Confirmado 2026-08-11: pedido explícito del usuario — la IA lee el N° de
  // comprobante/transacción del comprobante de pago (ya lo hace para el
  // monto) y queda guardado acá. Sirve para detectar si el mismo comprobante
  // se intenta reutilizar en otra solicitud (por error) — nunca visible en
  // las pantallas normales de Compras/Finanzas, solo en Auditoría.
  paymentProofReceiptNumber String?

  invoiceStatus PurchaseInvoiceStatus @default(PENDING)
  invoiceAmount Float?
  invoiceDocUrl String?
  invoicedById  String?
  invoicedBy    User?                 @relation("PurchaseRequestInvoicedBy", fields: [invoicedById], references: [id], onDelete: SetNull)
  // Confirmado 2026-08-13: pedido explícito del usuario — momento exacto en
  // que Finanzas cierra la operación (deja de estar PENDING). Alimenta el
  // tiempo total y por etapa que se muestra en Auditoría — una operación
  // recién aparece ahí cuando esto ya tiene valor.
  invoicedAt    DateTime?

  // Confirmado 2026-08-06: Nairoby puede marcar "revisar algo" en la misma
  // operación cuando algo no cuadra en su revisión final — opcional, no
  // obligatorio, y no bloquea nada por sí solo, solo deja visible la nota.
  financeFlagNote    String?
  financeFlaggedAt   DateTime?
  financeFlaggedById String?
  financeFlaggedBy   User?     @relation("PurchaseRequestFinanceFlaggedBy", fields: [financeFlaggedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipt              PurchaseRequestReceipt?
  urgentReports        PurchaseRequestUrgentReport[]
  marketingFollowUp    PurchaseReceiptFollowUp?
  linkedByOutflowItems MerchandiseOutflowItem[]      @relation("OutflowItemLinkedPurchase")

  @@index([deptId])
  @@index([status])
  @@index([catalogItemId])
  @@index([supplierId])
  @@index([requestedById])
  @@index([groupId])
  @@index([resubmittedFromGroupId])
  @@index([paymentProofReceiptNumber])
  @@index([shippingPaymentProofReceiptNumber])
}

// Inventario confirma que de verdad llegó — sin esto el ciclo no se cierra.
// Confirmado 2026-08-06: mínimo 2 fotos, máximo 3 (antes era 1 sola) — una
// del producto encima/junto al cartón del bulto, otra del cartón abierto con
// una unidad de muestra encima junto al bulto, para que la IA (aiPhotoMatch/
// aiPhotoNote) pueda comparar contra las fotos de referencia del catálogo.
// Fix confirmado 2026-08-08: cambio explícito de política — antes esto era
// solo apoyo visual y nunca bloqueaba; ahora el botón "Confirmar que llegó"
// SÍ se deshabilita en el cliente si aiPhotoMatch da false (producto distinto)
// o si la cantidad recibida no coincide con lo pedido — la única salida en
// esos casos es "Informar urgente" (PurchaseRequestUrgentReport).
model PurchaseRequestReceipt {
  id        String          @id @default(cuid())
  requestId String          @unique
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  receivedQuantity Int
  photoUrls        String[]
  // Confirmado 2026-08-18: pedido explícito del usuario — evidencia en video
  // ADEMÁS de las fotos (que siguen siendo obligatorias), opcional, útil
  // sobre todo cuando llegan muchos bultos a la vez. Mismo criterio que ya
  // usa PurchaseRequestUrgentReport.mediaUrls: se sube sin comprimir.
  videoUrls        String[] @default([])
  comment          String?

  aiPhotoMatch             Boolean?
  aiPhotoNote              String?
  // Confirmado 2026-08-12: pedido explícito del usuario — cuando la IA
  // confirma que sigue siendo el MISMO producto que el de referencia pero
  // con una diferencia menor (color, logo, empaque, etc.), el líder de
  // Inventario decide si lo deja pasar con un clic o lo reporta como algo
  // que no se puede dejar pasar. aiPhotoMatch se deja tal cual lo dio la IA
  // (false) — este campo es el registro de que se confirmó a pesar de eso.
  minorDifferenceConfirmed Boolean  @default(false)

  // Confirmado 2026-08-18: pedido explícito del usuario — quien de verdad
  // recibió la mercadería físicamente (cualquiera del equipo de Inventario,
  // ya no exclusivo de Daniel).
  confirmedById String?
  confirmedBy   User?    @relation("PurchaseRequestReceiptConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime @default(now())

  // Confirmado 2026-08-18: la aprobación final de Daniel (líder de
  // Inventario) — es lo que de verdad cierra el ciclo (request.status pasa a
  // RECEIVED recién acá, ver approve-receipt/route.ts). Null mientras está
  // en RECEIVED_PENDING_REVIEW.
  approvedById String?
  approvedBy   User?     @relation("PurchaseRequestReceiptApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  // Confirmado 2026-08-18: pedido explícito del usuario — checklist personal
  // de Daniel para pasar lo ya aprobado al sistema Justa. Independiente de
  // approvedAt: algo puede estar RECEIVED hace rato y seguir sin subir.
  justaUploadedById String?
  justaUploadedBy   User?     @relation("PurchaseRequestReceiptJustaUploadedBy", fields: [justaUploadedById], references: [id], onDelete: SetNull)
  justaUploadedAt   DateTime?
}

// Confirmado 2026-08-08: "Mercadería recibida" — pedido explícito del
// usuario, para que Análisis de Mercado (Bryan y su equipo) sepa cuándo
// llegó algo a bodega y qué falta hacer con eso. Se crea UNA fila por cada
// PurchaseRequest que pasa a RECEIVED (1:1, igual que PurchaseRequestReceipt).
// Dos confirmaciones totalmente independientes, cada una su propia tarea:
// designConfirmedAt = el diseñador (canConfirmMarketingDesign, hoy Robert)
// ya subió fotos reales brandeadas + video publicitario a Drive.
// advisorConfirmedAt = el asesor de cualquiera de las dos marcas
// (canConfirmMarketingAdvisor, hoy Heidy o Jariel) ya verificó stock, precio
// de venta, descripción y Dropi. No hay campo de marca en el catálogo — la
// marca mostrada en pantalla es solo informativa, derivada de QUIÉN
// confirmó (ver src/lib/marketingArrivals.ts), nunca usada para filtrar ni
// bloquear. Bryan (líder del área) nunca confirma nada acá — solo supervisa
// viendo el estado de todos.
model PurchaseReceiptFollowUp {
  id        String          @id @default(cuid())
  requestId String          @unique
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  designConfirmedAt   DateTime?
  designConfirmedById String?
  designConfirmedBy   User?     @relation("PurchaseReceiptFollowUpDesignConfirmedBy", fields: [designConfirmedById], references: [id], onDelete: SetNull)

  advisorConfirmedAt   DateTime?
  advisorConfirmedById String?
  advisorConfirmedBy   User?     @relation("PurchaseReceiptFollowUpAdvisorConfirmedBy", fields: [advisorConfirmedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// "Informar urgente" desde la confirmación de Inventario — mercadería
// dañada, faltante, incompleta, o que nunca llegó, de UN producto puntual
// de la solicitud (requestId). Confirmado 2026-08-06: cantidades separadas
// por tipo (no un solo "afectado" genérico) + evidencia obligatoria (al
// menos 1 foto; puede agregar 1 video) — todo comprimido antes de subir.
// El valor en disputa (money.ts: damagedQty+missingQty+incompleteQty ×
// request.unitCost) SIEMPRE se calcula del costo real de la cotización,
// nunca un monto escrito a mano — así no se puede inflar el reclamo.
model PurchaseRequestUrgentReport {
  id        String          @id @default(cuid())
  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  damagedQty    Int      @default(0)
  // Confirmado 2026-08-08: "Faltante" queda solo para reportes viejos —
  // ahora se reemplaza por "Diferente" (producto distinto al pedido, visible
  // gracias a las fotos de referencia del catálogo que ahora se muestran al
  // reportar). Nunca se borra el campo viejo para no perder el historial.
  missingQty    Int      @default(0)
  incompleteQty Int      @default(0)
  differentQty  Int      @default(0)
  description   String
  mediaUrls     String[]

  reportedById String?
  reportedBy   User?    @relation("PurchaseRequestUrgentReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  reportedAt   DateTime @default(now())

  // Confirmado 2026-08-18: pedido explícito del usuario — "Informar urgente"
  // ya no es exclusivo de Daniel (cualquiera de su equipo de Inventario
  // puede reportar), pero el reporte le llega primero a ÉL — no se notifica
  // a admin/solicitante ni aparece en la bandeja de Bryan (Reportes urgentes)
  // hasta que Daniel lo revisa acá.
  reviewedByLeadId String?
  reviewedByLead   User?     @relation("PurchaseRequestUrgentReportReviewedByLead", fields: [reviewedByLeadId], references: [id], onDelete: SetNull)
  reviewedByLeadAt DateTime?

  // ---------------- Reclamo posterior al cierre ----------------
  // Confirmado 2026-08-25: diseñado con el usuario paso a paso — daño
  // descubierto DÍAS después de que la mercadería ya se confirmó RECIBIDA
  // (ej. al despachar). Reutiliza este mismo modelo/resolución/crédito en
  // vez de una tabla aparte; isLateClaim distingue este camino del
  // "Informar urgente" normal (que solo existe antes de confirmar
  // recepción). Sin plazo límite para reportar — decisión explícita.
  isLateClaim   Boolean @default(false)
  // RPC-0001, RPC-0002... — numeración propia, independiente del SC-XXX de
  // la solicitud de origen porque el origen puede no ser exacto.
  lateClaimCode String? @unique

  // Si Inventario no puede saber con certeza de qué solicitud de compra
  // viene físicamente lo dañado (mercadería mezclada en bodega, sin lote
  // rastreable), requestId igual apunta a la más probable (elegida a mano),
  // pero el valor en disputa usa estimatedUnitCost (promedio de compras
  // recientes de ese producto+proveedor) en vez de request.unitCost.
  originUncertain   Boolean @default(false)
  estimatedUnitCost Float?

  stockStatus LateClaimStockStatus?

  // Revisión de Daniel con posibilidad de RECHAZAR (el "Informar urgente"
  // normal no tiene rechazo — reviewedByLeadAt siempre implicó aprobado).
  // Un reclamo rechazado queda igual visible, con el motivo, nunca se borra.
  rejectedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?     @relation("PurchaseRequestUrgentReportRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectionReason String?

  // Dar de baja en Just — DAFLOW no tiene integración con Just (nunca se
  // toca directamente), así que esto es una confirmación humana reforzada:
  // Daniel re-escribe la cantidad exacta (debe coincidir con justWriteOffQty
  // o la UI no deja confirmar) + declaración afirmativa, pedido explícito
  // del usuario para que no sea un clic ciego. Las resoluciones con el
  // proveedor (créditos/cambio) solo se pueden coordinar después de esto.
  justWriteOffQty   Int?
  justConfirmedById String?
  justConfirmedBy   User?     @relation("PurchaseRequestUrgentReportJustConfirmedBy", fields: [justConfirmedById], references: [id], onDelete: SetNull)
  justConfirmedAt   DateTime?

  resolutions PurchaseUrgentResolution[]

  @@index([requestId])
  @@index([isLateClaim])
}

enum LateClaimStockStatus {
  IN_STOCK
  SOLD
}

enum UrgentResolutionType {
  CREDIT
  REPLACEMENT
  REFUND
  WRITE_OFF
}

enum UrgentResolutionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Confirmado 2026-08-06: Bryan (líder de Compras/Análisis de Mercado, quien
// solicitó la compra) reparte la cantidad afectada de un reporte entre uno o
// varios caminos — puede dividirla (ej. 10 un. con crédito, 20 un. con
// reembolso). `quantity`/`amount` de cada resolución son una PORCIÓN de lo
// reportado, nunca más de lo que queda sin resolver (se valida en la ruta).
// El reporte se considera resuelto solo cuando la suma de resoluciones
// COMPLETED cubre el total reportado — mientras no sea así, Finanzas ve un
// aviso de que esa operación sigue con algo pendiente con el proveedor.
model PurchaseUrgentResolution {
  id       String                      @id @default(cuid())
  reportId String
  report   PurchaseRequestUrgentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  type     UrgentResolutionType
  quantity Int
  amount   Float
  // Nota libre — obligatoria solo para WRITE_OFF (por qué no se recupera).
  note     String?

  status UrgentResolutionStatus @default(PENDING)

  // REPLACEMENT — Bryan pone la fecha máxima; cuando llega, el equipo de
  // Inventario sube fotos + IA (mismo criterio que la recepción normal) y
  // Daniel da la aprobación final. Confirmado 2026-08-18: pedido explícito
  // del usuario — antes era un solo paso exclusivo de Daniel; ahora
  // replacementSubmittedAt/By es el sello del equipo (status se queda
  // PENDING) y replacementVerifiedAt/By es la aprobación final de Daniel
  // (recién ahí status pasa a COMPLETED).
  // Confirmado 2026-08-31: pedido explícito de Bryan — a veces el proveedor,
  // para no dar crédito ni reembolso, prefiere directamente entregar la
  // cantidad que faltó del pedido original (no es un cambio de producto
  // dañado/distinto). Mismo mecanismo de REPLACEMENT de punta a punta
  // (fecha límite, fotos, IA, aprobación de Daniel) — este flag solo cambia
  // cómo se rotula en pantalla.
  replacementIsMissingDelivery Boolean   @default(false)
  replacementDueDate           DateTime?
  replacementSubmittedById     String?
  replacementSubmittedBy       User?     @relation("UrgentResolutionReplacementSubmittedBy", fields: [replacementSubmittedById], references: [id], onDelete: SetNull)
  replacementSubmittedAt       DateTime?
  replacementArrivedAt         DateTime?
  replacementPhotoUrls         String[]
  replacementAiMatch           Boolean?
  replacementAiNote            String?
  replacementVerifiedById      String?
  replacementVerifiedBy        User?     @relation("UrgentResolutionReplacementVerifiedBy", fields: [replacementVerifiedById], references: [id], onDelete: SetNull)
  // Confirmado 2026-08-18: mismo checklist de Justa que
  // PurchaseRequestReceipt.justaUploadedAt — un reemplazo aprobado también
  // es mercadería física nueva que hay que cargar en Justa.
  justaUploadedById            String?
  justaUploadedBy              User?     @relation("UrgentResolutionJustaUploadedBy", fields: [justaUploadedById], references: [id], onDelete: SetNull)
  justaUploadedAt              DateTime?

  // REFUND — precio fijo (el mismo de la cotización), solo la cantidad se
  // ingresa; la IA cruza cantidad×precio contra el comprobante que suba el
  // proveedor, y el admin confirma en su cuenta bancaria antes de cerrar.
  refundProofUrl    String?
  refundAiMatch     Boolean?
  refundAiNote      String?
  bankConfirmedAt   DateTime?
  bankConfirmedById String?
  bankConfirmedBy   User?     @relation("UrgentResolutionBankConfirmedBy", fields: [bankConfirmedById], references: [id], onDelete: SetNull)

  // WRITE_OFF — se da por perdido, no hay nada más que recuperar (con una
  // nota de por qué); queda COMPLETED de inmediato.

  credit SupplierCredit?

  createdById String?
  createdBy   User?    @relation("UrgentResolutionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([reportId])
  @@index([status])
}

enum SupplierCreditStatus {
  AVAILABLE
  // Confirmado 2026-08-12: pedido explícito del usuario — apenas se marca un
  // crédito al solicitar una compra, queda "anclado" a esa solicitud
  // (reservedForGroupId) para que nadie más lo pueda usar mientras tanto.
  // Vuelve a AVAILABLE solo si la solicitud se rechaza por completo.
  RESERVED
  APPLIED
  REFUNDED
}

// Confirmado 2026-08-06: cuando algo llega dañado/incompleto/no llega y ya
// se pagó, en vez de perder ese dinero se registra como crédito con el
// proveedor (AVAILABLE) para aplicarlo a la siguiente compra que se le
// haga (APPLIED, appliedToGroupId). Nunca se elimina — es el respaldo de
// auditoría de por qué no se pagó el 100% de una compra. Si no se aplica
// dentro de 1 mes desde createdAt, se avisa automáticamente a admin,
// Nairoby y Bryan (ver getStaleSupplierCreditPushes en supplierCredits.ts).
model SupplierCredit {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  amount Float
  reason String

  urgentResolutionId String?                   @unique
  urgentResolution   PurchaseUrgentResolution? @relation(fields: [urgentResolutionId], references: [id], onDelete: SetNull)

  // Confirmado 2026-08-25 (Fase 2 de Registro de Egresos): crédito nacido de
  // un cambio de mercadería con proveedor resuelto como CREDIT_ISSUED —
  // mismo patrón que urgentResolutionId (null en los demás orígenes).
  outflowItemId String?                 @unique
  outflowItem   MerchandiseOutflowItem? @relation(fields: [outflowItemId], references: [id], onDelete: SetNull)

  // Confirmado 2026-08-12: pedido explícito del usuario — un crédito también
  // se puede registrar A MANO (sin pasar por un reporte urgente), siempre
  // con un comprobante obligatorio (captura del chat o documento donde el
  // proveedor acepta). urgentResolutionId queda null en ese caso — ya
  // distingue "automático" de "manual" sin necesidad de un campo aparte.
  proofUrl  String?
  proofName String?

  status SupplierCreditStatus @default(AVAILABLE)

  // Confirmado 2026-08-12: se llena apenas se marca este crédito al
  // solicitar una compra (antes de aprobar/pagar) — mientras tanto queda
  // fuera de la disponibilidad para cualquier otra solicitud con ese mismo
  // proveedor. Se limpia solo si esa solicitud se rechaza por completo.
  reservedForGroupId String?
  reservedAt         DateTime?

  appliedToGroupId String?
  appliedAt        DateTime?

  createdById String?
  createdBy   User?    @relation("SupplierCreditCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([supplierId])
  @@index([status])
  @@index([reservedForGroupId])
}

// Comprobante de pago (PDF o imagen) de un empleado para un mes/año — solo lo
// sube/edita la líder de Finanzas o el admin; cada empleado solo ve el suyo.
model PayStub {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("PayStubOwner", fields: [userId], references: [id], onDelete: Cascade)

  // Área del empleado al momento de subir el comprobante — se guarda aparte
  // para que el filtro por departamento siga funcionando aunque luego cambie
  // de área, igual que Supplier.createdByDeptId.
  deptId String?

  month Int // 1-12
  year  Int

  fileUrl  String
  fileName String

  // Null cuando lo sube el admin directamente (su sesión no tiene un User real).
  uploadedById String?
  uploadedBy   User?   @relation("PayStubUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
  @@index([deptId])
}

// Documento privado del admin (procesos, marketing, branding, patentes...)
// guardado en un bucket de Storage privado — no tiene una URL pública. Por
// defecto solo el admin lo ve; se puede compartir con personas puntuales via
// ConfidentialDocumentAccess. Nunca se sirve directo: siempre a través de una
// URL firmada de corta duración generada al momento, y nunca hay botón de
// descarga en la interfaz.
model ConfidentialDocument {
  id       String  @id @default(cuid())
  title    String
  category String? // libre: "Marketing", "Branding", "Patentes", "Procesos"...

  // Ruta dentro del bucket privado de Supabase Storage (no una URL pública).
  storagePath String
  fileName    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grants ConfidentialDocumentAccess[]

  @@index([category])
}

// A quién se le compartió un documento confidencial puntual. seenAt queda
// null hasta que esa persona lo abre por primera vez — así el aviso en el
// sidebar refleja shares concretos sin visitar, no solo una fecha de corte.
model ConfidentialDocumentAccess {
  id         String               @id @default(cuid())
  documentId String
  document   ConfidentialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  grantedAt DateTime  @default(now())
  seenAt    DateTime?

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

// Tracks who has already been shown the birthday popup for whom, on which
// calendar day — so it shows exactly once per person per occurrence and
// naturally reappears next year (a new date = a new row). viewerId/
// celebrantId are plain strings, not foreign keys, because the admin isn't a
// real User row — its sentinel id is the literal "admin".
model BirthdayPopupSeen {
  id              String   @id @default(cuid())
  viewerId        String
  celebrantId     String
  celebrationDate DateTime
  seenAt          DateTime @default(now())

  @@unique([viewerId, celebrantId, celebrationDate])
  @@index([viewerId, celebrationDate])
}

// Tasa de devolución general de toda la empresa — un valor por mes, copiado
// a mano de otra plataforma (no se calcula de otros datos). No está atada a
// un departamento; la sube quien lidera Finanzas (o el admin).
model ReturnRateRecord {
  id    String @id @default(cuid())
  // "YYYY-MM", lo que entrega <input type="month">.
  month String @unique
  value Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Catálogo reutilizable de productos para Ruptura de Stock — se crea una vez
// y luego se elige de la lista, en vez de escribirlo de nuevo cada semana.
model StockoutProduct {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  // Confirmado 2026-08-29 (pedido explícito del usuario): vínculo al mismo
  // catálogo real (Just) que usan Reingreso/Compras/Ventas Externas — ya no
  // se escribe el nombre a mano, se busca y elige del catálogo (ver
  // ProductMatchPicker). `name` se sigue llenando con el nombre del catálogo
  // al momento de elegirlo, para no romper el historial de semanas que ya
  // tenían productos guardados desde antes de este vínculo (catalogItemId
  // null en esas filas viejas).
  catalogItemId String?              @unique
  catalogItem   PurchaseCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  weeks StockoutWeekProduct[]
}

// Marca que un producto tuvo ruptura de stock (no se pudo despachar por
// falta de stock) en una semana puntual. La barra semanal en el gráfico es
// la CANTIDAD de productos distintos marcados esa semana — no una cantidad
// de unidades ni de veces repetido.
model StockoutWeekProduct {
  id        String          @id @default(cuid())
  // Semana ISO "YYYY-Www", igual que WeeklyMetricRecord.
  week      String
  productId String
  product   StockoutProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([week, productId])
  @@index([week])
  @@index([productId])
}

// Explicit "revisé esta semana y no hubo productos sin stock" — separate from
// simply having zero StockoutWeekProduct rows, since silence is ambiguous
// (genuinely nothing to report vs. the leader just forgot to log it). Used by
// the pendientes panel to only clear a week when either a product was
// attached OR this confirmation exists.
model StockoutWeekConfirmation {
  id        String   @id @default(cuid())
  week      String   @unique
  createdAt DateTime @default(now())
}

// Catálogo reutilizable de categorías/motivos de garantía (ej. "Aprobada",
// "Rechazada - producto roto") — se crea una vez y se reutiliza después.
model WarrantyCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  monthCounts WarrantyCategoryMonthCount[]
}

// "Total de garantías ingresadas" ese mes — el denominador para el % del
// Gráfico 1. Independiente de la suma de categorías (puede haber garantías
// aún sin categorizar).
model WarrantyMonthTotal {
  id        String   @id @default(cuid())
  month     String   @unique // "YYYY-MM"
  total     Int
  updatedAt DateTime @updatedAt
}

// Cuántas garantías de una categoría se registraron en un mes puntual. El
// Gráfico 1 (torta mensual) usa el mes más reciente; el Gráfico 2 (torta de
// "motivos que más se repiten") suma estos conteos de los últimos 12 meses
// para ver qué categoría acumula más — no se sube por separado, se calcula.
model WarrantyCategoryMonthCount {
  id         String           @id @default(cuid())
  month      String // "YYYY-MM"
  categoryId String
  category   WarrantyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  count      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, categoryId])
  @@index([month])
  @@index([categoryId])
}

/**
 * ---------------- Colaborador Destacado del Mes ----------------
 */

// Una evaluación mensual completa: un líder evaluando a un miembro de su
// equipo, o el admin evaluando a un líder. evaluatorId es "admin" (sentinel,
// sin FK, igual que en BirthdayPopupSeen) cuando lo hace el admin.
model MonthlyEvaluation {
  id          String  @id @default(cuid())
  month       String // "YYYY-MM"
  evaluatorId String // User.id o "admin"
  evaluateeId String
  evaluatee   User    @relation(fields: [evaluateeId], references: [id], onDelete: Cascade)
  comment     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores MonthlyEvaluationScore[]

  @@unique([month, evaluateeId])
  @@index([month])
  @@index([evaluateeId])
}

// Una fila por cada pregunta que le tocó a esa evaluación (elegidas al azar
// de un banco fijo por pilar — ver src/lib/recognition.ts). pillar +
// questionId identifican la pregunta exacta dentro de ese banco.
model MonthlyEvaluationScore {
  id           String            @id @default(cuid())
  evaluationId String
  evaluation   MonthlyEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  pillar       String
  questionId   String
  score        Int // 1-5

  @@unique([evaluationId, questionId])
  @@index([evaluationId])
}

// Resumen liviano de una evaluación — puntaje total + subtotal por cada uno
// de los 7 pilares, SIN el detalle de las 28 preguntas ni el comentario. Se
// escribe siempre junto con el MonthlyEvaluation detallado, y a diferencia
// de ese, NUNCA se borra — es lo que alimenta el ranking histórico y las
// gráficas de tendencia para siempre, incluso después de que el detalle
// pregunta-por-pregunta de un mes viejo se purga (ver RETENTION_MONTHS en
// src/lib/recognition.ts). El desempate sigue siendo exacto porque conserva
// los mismos subtotales por pilar que usa rankEvaluations().
model MonthlyEvaluationSummary {
  id          String @id @default(cuid())
  month       String // "YYYY-MM"
  evaluateeId String
  evaluatee   User   @relation(fields: [evaluateeId], references: [id], onDelete: Cascade)

  totalScore        Float
  resultadosScore   Int
  excelenciaScore   Int
  compromisoScore   Int
  colaboracionScore Int
  clienteScore      Int
  innovacionScore   Int
  liderazgoScore    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, evaluateeId])
  @@index([month])
}

// El podio (1°-3°) de un mes, confirmado por el admin con un clic. Queda
// fijo — no se recalcula en vivo — hasta que se confirme el mes siguiente.
model MonthlyRecognitionResult {
  id          String   @id @default(cuid())
  month       String // "YYYY-MM"
  rank        Int // 1, 2 o 3
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalScore  Float
  confirmedAt DateTime @default(now())

  @@unique([month, rank])
  @@index([month])
}

// Mismo patrón que BirthdayPopupSeen — cada popup de celebración (1°, 2° o
// 3° lugar) aparece una sola vez por persona por mes, y se registran por
// separado (uno por rank) para poder mostrarlos en secuencia.
model MonthlyRecognitionPopupSeen {
  id       String   @id @default(cuid())
  viewerId String // User.id o "admin"
  month    String
  rank     Int      @default(1) // 1, 2 o 3
  seenAt   DateTime @default(now())

  @@unique([viewerId, month, rank])
}

/**
 * ---------------- Rutas de conocimiento ----------------
 */
// Confirmado 2026-07-27: el admin arma, por persona (no por puesto formal de
// Nómina), una ruta de pasos ordenados que referencian contenido que ya
// existe en DAFLOW (un Documento/Ley, un Proceso o un Módulo completo). Cada
// contenido tiene un único "banco" de preguntas (ContentQuestionSet) generado
// una vez por IA y reutilizado en cualquier ruta que lo incluya — nunca se
// regenera solo por agregarlo a una nueva ruta.
model LearningPath {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       LearningPathStep[]
  assignments LearningPathAssignment[]
}

model LearningPathStep {
  id            String             @id @default(cuid())
  pathId        String
  path          LearningPath       @relation(fields: [pathId], references: [id], onDelete: Cascade)
  order         Int                @default(0)
  questionSetId String
  questionSet   ContentQuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)

  progress LearningPathStepProgress[]

  @@index([pathId])
  @@index([questionSetId])
}

// El "banco" de preguntas de una pieza de contenido — exactamente uno de
// documentId/processId/moduleId está presente (mismo patrón que Exam). Único
// por contenido: si dos rutas distintas incluyen el mismo Documento, comparten
// este mismo registro en vez de generar (y pagar IA) dos veces.
model ContentQuestionSet {
  id               String    @id @default(cuid())
  documentId       String?   @unique
  document         Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  processId        String?   @unique
  process          Process?  @relation(fields: [processId], references: [id], onDelete: Cascade)
  moduleId         String?   @unique
  module           Module?   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  aiModel          String // qué modelo de Claude generó estas preguntas (ej. "claude-sonnet-5")
  estimatedMinutes Int       @default(10) // tiempo estimado de lectura + responder, para el medidor 2-8h de cada ruta
  // Cuántas preguntas del banco ve cada persona en un intento normal — el
  // resto son variantes de repuesto. Confirmado 2026-07-27: para que dos
  // personas con la misma ruta no vean exactamente las mismas preguntas (y
  // por lo tanto no puedan simplemente copiarse las respuestas), se genera un
  // banco más grande de lo necesario y a cada persona se le muestra una
  // muestra aleatoria (determinística por persona) de este tamaño.
  sampleSize       Int       @default(3)
  generatedAt      DateTime  @default(now())

  questions LearningPathQuestion[]
  steps     LearningPathStep[]
}

enum LearningPathQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MATCHING
  SHORT_ANSWER
}

model LearningPathQuestion {
  id    String                   @id @default(cuid())
  setId String
  set   ContentQuestionSet       @relation(fields: [setId], references: [id], onDelete: Cascade)
  type  LearningPathQuestionType
  text  String
  order Int                      @default(0)

  // MULTIPLE_CHOICE: options = alternativas, correctIndex = la correcta.
  // TRUE_FALSE: options = ["Verdadero","Falso"], correctIndex = 0 o 1.
  // MATCHING: matchLeft[i] se empareja con options[i] (misma posición = par correcto).
  // SHORT_ANSWER: sin correctIndex — el admin revisa la respuesta escrita manualmente.
  options      String[] @default([])
  matchLeft    String[] @default([])
  correctIndex Int?

  answers LearningPathAnswer[]

  @@index([setId])
}

// A quién el admin le asignó la ruta — independiente del puesto de Nómina;
// una persona puede tener varias rutas asignadas.
model LearningPathAssignment {
  id         String       @id @default(cuid())
  pathId     String
  path       LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation("LearningPathAssignedTo", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime     @default(now())

  @@unique([pathId, userId])
  @@index([userId])
}

// Confirmado 2026-07-27: aprobar un paso requiere nota >= 8/10
// (correctCount/totalCount). Si reprueba, no desbloquea el siguiente paso —
// puede reintentar recién a las 24 horas laborables (attemptNumber sube en
// cada intento, así el muestreo anti-copia también cambia entre intentos).
model LearningPathStepProgress {
  id               String           @id @default(cuid())
  stepId           String
  step             LearningPathStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  userId           String
  user             User             @relation("LearningPathStepProgressBy", fields: [userId], references: [id], onDelete: Cascade)
  attemptNumber    Int              @default(1)
  completedAt      DateTime?
  correctCount     Int?
  totalCount       Int?
  // Solo si reprobó (correctCount/totalCount < 0.8) — cuándo puede reintentar.
  retryAvailableAt DateTime?

  answers LearningPathAnswer[]

  @@unique([stepId, userId, attemptNumber])
  @@index([userId])
}

model LearningPathAnswer {
  id            String                   @id @default(cuid())
  progressId    String
  progress      LearningPathStepProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  questionId    String
  question      LearningPathQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int? // MULTIPLE_CHOICE / TRUE_FALSE
  matchOrder    Int[]                    @default([]) // MATCHING: orden que el colaborador emparejó, por índice de options
  textAnswer    String? // SHORT_ANSWER — el admin la lee, no se autocalifica
  isCorrect     Boolean?
  answeredAt    DateTime                 @default(now())

  @@unique([progressId, questionId])
  @@index([questionId])
}

/**
 * ---------------- Chat interno de Roles de pago ----------------
 */
// Confirmado 2026-07-27: por cada colaborador, un hilo de mensajes directo
// entre él y quien gestione su nómina (hoy Nairoby, líder de Finanzas, o el
// admin subiendo directo) — el admin puede ver TODAS las conversaciones de
// cualquier área, pero no escribe en ellas (transparencia, no participación).
// senderId es siempre employeeId (el colaborador respondiendo) o quien
// gestiona la nómina — nunca el admin.
model PayrollMessage {
  id         String    @id @default(cuid())
  employeeId String
  employee   User      @relation("PayrollMessageEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User      @relation("PayrollMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime  @default(now())
  // Null hasta que la otra parte del hilo (no el admin, que solo observa) lo lee.
  readAt     DateTime?

  @@index([employeeId])
}

/**
 * ---------------- Historial de conversaciones con Nancy ----------------
 */
// Confirmado 2026-07-27: antes las conversaciones con Nancy solo vivían en
// memoria del navegador — se perdían al salir de la pantalla. Ahora cada
// conversación se guarda completa (se auto-crea con el primer mensaje) y se
// puede retomar después, o dejarla y abrir una nueva. ownerId es User.id o
// el string "admin" (mismo patrón sin FK que MonthlyRecognitionPopupSeen —
// el admin no es una fila real de User) — cada quien solo ve sus propias
// conversaciones, no se comparten entre admin y el líder del área.
model NancyConversation {
  id         String     @id @default(cuid())
  deptId     String
  department Department @relation(fields: [deptId], references: [id], onDelete: Cascade)
  ownerId    String
  title      String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  messages NancyMessage[]

  @@index([deptId, ownerId])
}

model NancyMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   NancyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime          @default(now())

  @@index([conversationId])
}

// Check-in semanal — asistente separado de Nancy/FERNICK, uno por empleado
// por semana (reemplaza la reunión 1:1 admin-líder). Mismo patrón deptId +
// ownerId escopado que Nancy; a diferencia de Nancy, ownerId aquí siempre es
// un User real (este asistente es exclusivo de empleados, nunca admin), pero
// se deja sin FK, mismo estilo que NancyConversation.ownerId.
model CheckinConversation {
  id         String     @id @default(cuid())
  ownerId    String
  deptId     String
  department Department @relation(fields: [deptId], references: [id], onDelete: Cascade)
  // Semana ISO "YYYY-Www" — un hilo nuevo por semana, coherente con el
  // recordatorio fijo de los viernes (ver getWeeklyCheckinPushes).
  weekOf     String
  title      String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  messages CheckinMessage[]

  @@index([ownerId, weekOf])
  @@index([deptId])
}

model CheckinMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   CheckinConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime            @default(now())

  @@index([conversationId])
}

// Confirmado 2026-08-24: FERNICK, el asistente empresarial estratégico
// (crecimiento de facturación) — exclusivo de admin, sin deptId porque
// razona sobre TODA la empresa (finanzas, inventario, operación, compras),
// no un departamento puntual. Mismo patrón sin FK de ownerId que
// NancyConversation (hoy siempre "admin", ver fernickOwnerId en fernick.ts).
model FernickConversation {
  id        String   @id @default(cuid())
  ownerId   String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages FernickMessage[]

  @@index([ownerId])
}

model FernickMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   FernickConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime            @default(now())

  @@index([conversationId])
}

// Confirmado 2026-07-29: panel de gasto de IA, solo visible para admin (ve
// /admin/gasto-ia). Registra cada llamada real a la IA (Nancy, generación de
// preguntas de Rutas de conocimiento) con sus tokens reales reportados por
// Anthropic — el costo se calcula una vez al guardar (ver src/lib/aiPricing.ts)
// en vez de recalcularlo siempre contra una tabla de precios que puede
// cambiar. actorId es User.id o el sentinel "admin" (mismo patrón sin FK que
// NancyConversation.ownerId).
model AiUsageLog {
  id           String   @id @default(cuid())
  feature      String // "nancy" | "rutas_conocimiento"
  model        String
  actorId      String
  deptId       String?
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([feature])
}

// Confirmado 2026-07-28: notificaciones push (laptop y celular) para avisar
// de "Pendientes" aunque la persona no tenga DAFLOW abierto. ownerId es
// User.id o el sentinel "admin" (mismo patrón sin FK que NancyConversation).
// Una persona puede tener varias suscripciones a la vez (una por
// celular/laptop donde active el permiso) — por eso es una tabla aparte y no
// un campo único en User. `endpoint` es único porque el navegador lo genera
// distinto por dispositivo/instalación.
model PushSubscription {
  id        String   @id @default(cuid())
  ownerId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([ownerId])
}

// Confirmado 2026-07-28: no todos quieren que TODOS sus tipos de pendiente
// les llegue como notificación push — cada quien puede apagar tipos
// puntuales (ej. "Pagos recordatorios" sí, "Roles de pago" no). Por defecto
// todo está activado — una fila aquí SOLO existe para un tipo que la
// persona apagó explícitamente; su ausencia significa "activado". Así nadie
// tiene que configurar nada si le sirve el comportamiento por defecto.
model PushCategoryPreference {
  id         String   @id @default(cuid())
  ownerId    String
  type       String
  disabledAt DateTime @default(now())

  @@unique([ownerId, type])
  @@index([ownerId])
}

/**
 * ---------------- Pagos administrativos (Finanzas) ----------------
 */
// Confirmado 2026-08-06: Nairoby (líder de Finanzas) solicita pagos
// administrativos (IESS, sueldos, alquiler, etc.) y el admin los paga y sube
// comprobante — la IA cruza el monto en ambos puntos (doc. de soporte
// opcional al crear, comprobante obligatorio al pagar). Distinto de "Pagos
// recordatorios" (rastreador de vencimientos con checkbox, sin
// solicitante/pagador separados ni archivos).
enum AdminPaymentType {
  RECURRING
  VARIABLE
}

enum AdminPaymentStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
}

// Confirmado 2026-08-06: a quién se le paga (Bryan por una devolución, un
// restaurante por almuerzos, etc.) — catálogo liviano y reutilizable,
// deliberadamente SIN los campos de Supplier (ubicación, categoría,
// aprobación, WhatsApp) que no aplican acá; solo nombre + cuentas bancarias,
// mismo patrón "varias cuentas, agregar todas, borrar solo admin" ya usado
// en Control de Compras.
model AdminPaymentPayee {
  id          String   @id @default(cuid())
  name        String   @unique
  createdById String?
  createdBy   User?    @relation("AdminPaymentPayeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  bankAccounts AdminPaymentPayeeBankAccount[]
  requests     AdminPaymentRequest[]
}

model AdminPaymentPayeeBankAccount {
  id      String            @id @default(cuid())
  payeeId String
  payee   AdminPaymentPayee @relation(fields: [payeeId], references: [id], onDelete: Cascade)

  bankName          String
  bankAccountType   String
  bankAccountNumber String
  bankAccountHolder String
  holderIdType      HolderIdType?
  holderIdNumber    String?

  createdById String?
  createdBy   User?    @relation("AdminPaymentPayeeBankAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  requests AdminPaymentRequest[]

  @@index([payeeId])
}

// Serie recurrente (ej. "Planilla IESS") — el motivo es fijo pero el monto
// varía cada mes, así que solo sirve de plantilla/serie; el monto real vive
// en cada AdminPaymentRequest. Catálogo "escribe o elige" (mismo patrón que
// proveedores/bancos de Control de Compras).
model AdminPaymentTemplate {
  id          String   @id @default(cuid())
  motivo      String   @unique
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("AdminPaymentTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  requests AdminPaymentRequest[]
}

// Confirmado 2026-08-06: la reaparición mensual de una recurrente es
// perezosa (sin cron que la cree sola) — se calcula en memoria comparando
// plantillas activas contra @@unique([templateId, period]) del mes actual,
// igual que PaymentReminder/PaymentReminderRecord.
model AdminPaymentRequest {
  id String @id @default(cuid())

  type       AdminPaymentType
  templateId String?
  template   AdminPaymentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  period     String? // "YYYY-MM", solo type=RECURRING

  motivo String
  monto  Float
  status AdminPaymentStatus @default(PENDING_PAYMENT)

  // Confirmado 2026-08-06: a quién y a qué cuenta se le paga — opcional
  // porque solicitudes viejas (antes de este campo) no lo tienen.
  payeeId       String?
  payee         AdminPaymentPayee?            @relation(fields: [payeeId], references: [id], onDelete: SetNull)
  bankAccountId String?
  bankAccount   AdminPaymentPayeeBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  // Confirmado 2026-08-06: mismo vínculo con una orden de compra que ya
  // existe en Caja Chica (PettyCashEntry.linkedGroupId) — para cuando el
  // flete pendiente de esa orden se paga por transferencia en vez de caja
  // chica. Al subir el comprobante, markGroupFreightPaid() escribe el monto
  // REAL pagado de vuelta en PurchaseRequest.shippingCostTotal.
  linkedGroupId String?

  // Doc. de soporte opcional al crear — bloqueante si la IA no lo hace calzar
  declarationFileUrl  String?
  declarationFileName String?
  declarationAiMatch  Boolean?
  declarationAiNote   String?

  // Comprobante de pago del admin — obligatorio para pasar a PAID, bloqueante.
  // Confirmado 2026-08-31: pedido explícito del usuario — una solicitud
  // puede pagarse con varios comprobantes (ej. $5 a un número + $4 a una
  // cuenta), así que ahora también existe `proofs` (uno-a-varios, ver abajo)
  // con la lista completa. Estos campos scalares se siguen llenando con el
  // ÚLTIMO comprobante subido (compat con solicitudes viejas y con la UI que
  // ya los usaba como señal de "ya hay comprobante"); paymentAiReadAmount
  // pasa a ser la SUMA de todos los comprobantes de `proofs`, no solo el
  // último, y paymentAiMatch/paymentAiNote reflejan esa suma.
  paymentProofUrl     String?
  paymentProofName    String?
  paymentAiMatch      Boolean?
  paymentAiNote       String?
  paymentAiReadAmount Float?
  proofs              AdminPaymentProof[]
  // Confirmado 2026-08-12: pedido explícito del usuario — solo el admin (el
  // único que hace estos pagos) puede, con un clic + una breve nota, dar por
  // buena una transacción cuando el comprobante no coincide con lo
  // declarado (ej. comisión bancaria distinta). paymentAiMatch se deja tal
  // cual lo leyó la IA (false) — este campo es el registro de auditoría de
  // por qué igual se dio por pagado.
  paymentOverrideNote String?

  // Confirmado 2026-08-12: pedido explícito del usuario — al hacer el pago,
  // opcionalmente se puede adjuntar un segundo documento/imagen de soporte
  // (ej. captura extra del banco) y una descripción breve. Nunca pasa por
  // verificación de IA (es solo contexto adicional) y no bloquea nada.
  paymentExtraFileUrl  String?
  paymentExtraFileName String?
  paymentNote          String?

  paidAt   DateTime?
  paidById String?
  paidBy   User?     @relation("AdminPaymentPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  // Confirmado 2026-08-06: se guarda para que el botón "Enviar confirmación
  // de pago" quede fijo en "Pago enviado" tras el primer clic (en vez de
  // volver a su texto original a los segundos, que hacía pensar que no se
  // había avisado) — el admin igual puede reenviar cuando quiera.
  paymentNotifiedAt DateTime?

  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?     @relation("AdminPaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("AdminPaymentRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([templateId, period])
  @@index([status])
  @@index([type])
  @@index([linkedGroupId])
}

// Confirmado 2026-08-31: pedido explícito del usuario — una solicitud de
// pago puede cubrirse con más de un comprobante (ej. $5 a un número + $4 a
// una cuenta para completar $9). Cada comprobante se lee con IA por
// separado (monto + número de comprobante/transacción del banco, solo de
// referencia) y se guarda aparte; el request se marca PAID solo cuando la
// SUMA de readAmount de todos sus proofs llega o supera `monto`.
model AdminPaymentProof {
  id        String              @id @default(cuid())
  requestId String
  request   AdminPaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  fileUrl       String
  fileName      String?
  readAmount    Float?
  receiptNumber String?

  createdAt DateTime @default(now())

  @@index([requestId])
}

/**
 * ---------------- Nómina: calculadora de horas extra y roles de pago ----------------
 */
// Confirmado 2026-08-13: pedido explícito del usuario, tras varias rondas de
// diseño — reemplaza el cálculo manual en Excel. Vive dentro de la sección
// "Nómina" que ya existía. Todo el detalle real (sueldo real, horas extra,
// bonos, descuentos) es exclusivo de Nairoby Castro (edita) y el admin
// (solo ve, sin poder editar) — nadie más tiene acceso, ni siquiera con un
// flag delegado. Los colaboradores solo ven un "Rol del mes" simplificado
// (MonthlyLegalRole), calculado sobre el sueldo declarado en el IESS.

enum PayrollLineItemKind {
  INCOME
  EXPENSE
}

enum PayrollPeriodStatus {
  DRAFT
  PUBLISHED
}

// Datos de sueldo e interruptores por persona — aparte de User porque son
// datos sensibles que solo Nairoby edita, no un "escape hatch" delegable
// como el resto de canManageX del sistema.
model PayrollProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  realSalary         Float?
  iessDeclaredSalary Float?

  // La empresa asume el 100% del aporte del IESS de esta persona (hoy solo
  // Andrés y Marcos) — no se le descuenta nada de IESS en su rol, aunque la
  // empresa lo sigue pagando por su lado.
  companyAbsorbsIess Boolean @default(false)

  // Confirmado 2026-08-27: pedido explícito del usuario, corrigiendo la
  // tarifa fija que se había asumido antes — el IESS cobra una prima extra
  // de salud/maternidad (IESS_PART_TIME_RATE = 4.41%, ver payrollCalc.ts)
  // SOLO a quienes están registrados a tiempo parcial (en la planilla real
  // aparecen sin los 30 días completos). Hoy son quienes declaran "mitad de
  // sueldo" — Andrés y Marcos, que sí están a 30 días, NO la tienen. Se
  // activa persona por persona (mismo patrón que companyAbsorbsIess) y
  // nunca se descuenta a la persona — solo se suma al total agregado que se
  // transfiere para pagar el IESS (ver iessBreakdownFromRoles en payroll.ts).
  iessPartTime Boolean @default(false)

  // Confirmado 2026-08-27: pedido explícito del usuario — extensión de
  // cónyuge al IESS (3.41% del sueldo declarado, IESS_SPOUSE_EXTENSION_RATE
  // en payrollCalc.ts). Hoy solo Dexi Villafuerte está asegurada al IESS
  // con esa extensión (el usuario cobra su propio sueldo por medio de ella,
  // sin figurar él mismo en Nómina). Mismo patrón que iessPartTime: se
  // activa persona por persona, nunca se descuenta a la persona, solo se
  // suma al total agregado que se transfiere para pagar el IESS.
  iessSpouseExtension Boolean @default(false)

  // Habilita que le aparezca la pantalla de registrar horas extra — apagado
  // por defecto, se prende persona por persona (hoy Inventario y
  // Fulfillment).
  canLogOvertimeHours Boolean @default(false)

  // Umbral más estricto/legal de horas extra (después de las 5pm entre
  // semana, y TODO el sábado 8:30-12:30 cuenta como extra) en vez del
  // umbral por defecto (después de las 6:30pm; el sábado 8:30-13:30 es
  // turno normal, no extra). Se activa persona por persona a medida que se
  // pueda costear pagar así a todos.
  usesFullLegalOvertimeSchedule Boolean @default(false)

  // Confirmado 2026-08-25: excepción para Mercedes Espinoza, asesora
  // externa que se paga completo al fin de mes en vez de dividirse en dos
  // quincenas — un solo concepto "Sueldo (mensual)" con el sueldo real
  // completo en Q2, nada en Q1. Persona por persona, igual que
  // companyAbsorbsIess.
  monthlySalaryOnly Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Fila única — sueldo básico nacional vigente, usado para calcular el valor
// de toda hora extra de todo el personal. Se actualiza acá cuando el
// gobierno lo cambie.
model PayrollSettings {
  id                 String   @id @default(cuid())
  nationalBaseSalary Float
  updatedAt          DateTime @updatedAt
  updatedById        String?
  updatedBy          User?    @relation("PayrollSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

// El líder de cada área (incluido él mismo) carga, día por día, cuánto se
// quedó extra — nunca hora de entrada/salida libre, siempre en pasos de 45
// min o 1 hora. Solo se puede cargar/corregir dentro de las 24h siguientes
// a ese día (ver isEditableOvertimeDate en payrollCalc.ts) — pasado eso,
// ese día queda cerrado para siempre, para evitar cargar horas de semanas
// pasadas. Sin approvedAt, ese día no cuenta para nada del cálculo mensual.
model OvertimeEntry {
  id         String   @id @default(cuid())
  employeeId String
  employee   User     @relation("OvertimeEntryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime // medianoche UTC del día trabajado

  minutesExtra Int // 45 o 60

  enteredById String?
  enteredBy   User?    @relation("OvertimeEntryEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  enteredAt   DateTime @default(now())

  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("OvertimeEntryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  // Rechazar ya no borra el registro (lo hacía antes) — se conserva como
  // historial visible para el líder que lo cargó, el admin y Nairoby.
  rejectedAt   DateTime?
  rejectedById String?
  rejectedBy   User?     @relation("OvertimeEntryRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([approvedAt])
}

// Una fila por quincena (ej. "2026-08-Q1" = 1-15 agosto) — global, no por
// persona. Nairoby genera el borrador de todos a la vez y publica de una.
model PayrollPeriod {
  id     String @id @default(cuid())
  period String @unique // "YYYY-MM-Q1" o "YYYY-MM-Q2"

  status PayrollPeriodStatus @default(DRAFT)

  generatedAt   DateTime?
  generatedById String?
  generatedBy   User?     @relation("PayrollPeriodGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)

  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation("PayrollPeriodPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  roles        PayrollQuincenaRole[]
  transfer     PayrollTransfer?
  iessTransfer PayrollIessTransfer?

  @@index([status])
}

enum PayrollTransferStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}

// Confirmado 2026-08-24: el destino dejó de ser 100% automático por
// quincena — Nairoby elige entre estas 3 al enviar el total (con un
// default sugerido según el período), para poder evitar una cuenta sin
// fondos. ADMIN_COMPANY reusa la misma cuenta de CompanyBankAccount que ya
// se usa para compras personales (Pichincha) — no es una cuenta nueva.
enum PayrollTransferDestination {
  NAIROBY
  ADMIN_PRODUBANCO
  ADMIN_COMPANY
}

// Confirmado 2026-08-23: transferencia real de fondos por quincena — no es
// solo un registro contable. El admin transfiere el TOTAL de la quincena
// (suma de Líquido a pagar de todos los roles) a una de dos cuentas fijas
// según el período: 1ra quincena (Q1) -> cuenta bancaria de Nairoby (ella
// distribuye), 2da quincena/fin de mes (Q2) -> cuenta Produbanco propia del
// admin (Nairoby entra ahí y paga uno por uno). Se crea/actualiza
// automáticamente al publicar el período — nunca antes (los roles deben
// estar generados y publicados primero, nunca estimados). Confidencial:
// mismo criterio de acceso que PayrollQuincenaRole (canViewPayrollRoles /
// canEditPayrollRoles) — ningún colaborador lo ve jamás. Aprobar/rechazar
// es exclusivo del admin; una corrección posterior de un rol (ver
// roles/[roleId]/correct) recalcula totalAmount y saca a esto de REJECTED,
// pero nunca toca un registro ya APPROVED/COMPLETED — esa plata ya se movió.
model PayrollTransfer {
  id       String        @id @default(cuid())
  periodId String        @unique
  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  totalAmount Float
  destination PayrollTransferDestination

  status PayrollTransferStatus @default(PENDING_APPROVAL)

  rejectionReason String?
  rejectedAt      DateTime?
  approvedAt      DateTime?

  proofUrl    String?
  proofName   String?
  // Número de comprobante/transacción que la IA extrae del recibo (pedido
  // explícito 2026-08-27) — no se deja confirmar el pago hasta que tanto el
  // monto como este número se hayan podido leer, ver proof/route.ts.
  proofNumber String?
  completedAt DateTime?

  // El admin confirma que ya transfirió a una cuenta propia sin necesitar
  // subir una foto de comprobante (pedido explícito 2026-08-27) — queda
  // marcado explícitamente distinto de un comprobante real, con quién y a
  // qué hora hizo el clic como respaldo en su lugar. Solo el admin usa esto
  // (guardado en el cliente) y su sesión no es una fila de User (id fijo
  // "admin" en auth.ts) — por eso el nombre se guarda como texto plano, sin
  // relación a User.
  confirmedWithoutProof       Boolean   @default(false)
  confirmedWithoutProofNote   String?
  confirmedWithoutProofAt     DateTime?
  confirmedWithoutProofByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Confirmado 2026-08-26: pedido explícito del usuario — total aparte del de
// nómina, con lo retenido de IESS de TODOS los colaboradores esa quincena
// (siempre fin de mes, ver totalIessFromRoles en payroll.ts). Mismo ciclo
// de vida y mismas 3 cuentas destino que PayrollTransfer (reusa
// PayrollTransferStatus/PayrollTransferDestination), pero es un registro
// totalmente aparte — un envío/aprobación/comprobante de nómina no afecta
// al de IESS y viceversa. Default sugerido de cuenta: "Cuenta para recibir
// transferencias" (Pichincha 0970), confirmado con el usuario.
model PayrollIessTransfer {
  id       String        @id @default(cuid())
  periodId String        @unique
  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  totalAmount Float
  destination PayrollTransferDestination

  status PayrollTransferStatus @default(PENDING_APPROVAL)

  rejectionReason String?
  rejectedAt      DateTime?
  approvedAt      DateTime?

  proofUrl    String?
  proofName   String?
  // Número de comprobante/transacción que la IA extrae del recibo (pedido
  // explícito 2026-08-27) — no se deja confirmar el pago hasta que tanto el
  // monto como este número se hayan podido leer, ver proof/route.ts.
  proofNumber String?
  completedAt DateTime?

  // Mismo patrón que PayrollTransfer.confirmedWithoutProof — ver ahí.
  confirmedWithoutProof       Boolean   @default(false)
  confirmedWithoutProofNote   String?
  confirmedWithoutProofAt     DateTime?
  confirmedWithoutProofByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Mismo patrón singleton que CompanyBankAccount, pero confidencial (solo
// Nairoby/admin la leen, nunca pública) — cuenta Produbanco personal del
// admin, usada solo para recibir la nómina de la 2da quincena/fin de mes;
// Nairoby entra a esta cuenta y paga a cada colaborador desde ahí.
model AdminPayrollBankAccount {
  id                String        @id @default("singleton")
  bankName          String?
  bankAccountType   String?
  bankAccountNumber String?
  bankAccountHolder String?
  holderIdType      HolderIdType?
  holderIdNumber    String?
  updatedAt         DateTime      @updatedAt
}

// El detalle real completo de lo que se le paga a cada persona esa
// quincena — exclusivo de Nairoby y el admin, el colaborador NUNCA lo ve.
// Todo (sueldo, horas extra, IESS, bonos, descuentos) vive como
// PayrollLineItem — este modelo solo guarda los totales ya calculados +
// el versionado. Al corregir uno ya publicado, se crea una fila nueva con
// isCurrent=true y se apaga la anterior — nunca se sobreescribe.
model PayrollQuincenaRole {
  id         String        @id @default(cuid())
  periodId   String
  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String
  employee   User          @relation("PayrollQuincenaRoleEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  version    Int     @default(1)
  isCurrent  Boolean @default(true)
  // Obligatorio cuando version > 1 — nota interna para Nairoby/admin.
  changeNote String?

  totalIncome  Float
  totalExpense Float
  netTotal     Float

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("PayrollQuincenaRoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Pago individual a este colaborador (después de que Nairoby ya tiene el
  // total en su poder / cuenta correspondiente — ver PayrollTransfer). La IA
  // lee el monto del comprobante y se compara contra netTotal antes de dejar
  // confirmar, mismo patrón bloqueante que PayrollTransfer.proof.
  paidAt                 DateTime?
  paidProofUrl           String?
  paidProofName          String?
  paidProofReadAmount    Float?
  // Número de comprobante/transacción que la IA extrae del recibo (pedido
  // explícito 2026-08-27) — junto con paidProofReadAmount, ambos deben
  // coincidir/leerse antes de dejar confirmar el pago, ver
  // individual-payment/route.ts.
  paidProofNumber        String?
  // Nombre del beneficiario que la IA lee del comprobante (pedido explícito
  // 2026-08-27) — debe coincidir con el titular de la cuenta bancaria que
  // este colaborador registró, para evitar subir el comprobante de otra
  // persona por error (ver namesLikelyMatch en payrollTransferAi.ts).
  paidProofRecipientName String?

  lineItems PayrollLineItem[]

  @@index([periodId])
  @@index([employeeId])
  @@index([employeeId, isCurrent])
}

model PayrollLineItem {
  id     String              @id @default(cuid())
  roleId String
  role   PayrollQuincenaRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  label  String
  amount Float
  kind   PayrollLineItemKind

  // true = línea agregada sola (ej. "+$50 Colaborador destacado", sueldo,
  // horas extra) — Nairoby igual la puede editar o quitar.
  isAutomatic Boolean @default(false)

  // Confirmado 2026-08-17: pedido explícito del usuario — cuando el sistema
  // genera una línea automática con una fórmula detrás (por ahora solo
  // horas extra), guarda un resumen de cómo se calculó, para que se pueda
  // verificar a simple vista que se calculó tal como se pidió. Se calcula
  // una sola vez al generar y queda fijo — es parte del registro histórico.
  note String?

  @@index([roleId])
}

// Lo único que ve cada colaborador en "Roles de pago" — nunca el detalle
// real de PayrollQuincenaRole. Se llama "Rol del mes" en pantalla (nunca
// "quincena", para que no parezca que falta otro) — calculado sobre el
// sueldo DECLARADO en el IESS (la mitad para casi todos), con su
// descuento de IESS. Se genera/actualiza junto con la quincena de fin de
// mes. Versionado igual que PayrollQuincenaRole: una corrección nunca
// borra, crea una versión nueva "principal" con nota — esta nota SÍ la ve
// el colaborador, para que entienda por qué cambió.
model MonthlyLegalRole {
  id         String @id @default(cuid())
  employeeId String
  employee   User   @relation("MonthlyLegalRoleEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  month      String // "YYYY-MM"

  version    Int     @default(1)
  isCurrent  Boolean @default(true)
  changeNote String?

  declaredSalary Float
  iessDeduction  Float
  netTotal       Float

  publishedAt   DateTime @default(now())
  publishedById String?
  publishedBy   User?    @relation("MonthlyLegalRolePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  // Comprobante del pago individual de fin de mes — SOLO se copia acá (y por
  // lo tanto solo se le muestra al colaborador) cuando el monto real
  // transferido coincidía exacto con netTotal (declaredSalary − IESS). Si no
  // coincidía, estos quedan null a propósito — ver publish/route.ts. Nunca
  // se copia el de la primera quincena (esta tabla no existe para Q1).
  paidAt          DateTime?
  payoutProofUrl  String?
  payoutProofName String?

  @@unique([employeeId, month, version])
  @@index([employeeId])
  @@index([employeeId, isCurrent])
}

/**
 * ---------------- Comisiones de equipo por niveles + Bonos discrecionales del CEO ----------------
 */
// Confirmado 2026-08-14: diseñado en conversación larga con el usuario, no
// re-derivar. 3 niveles (Raíz/Cosecha/PROVEDIX) según el promedio DIARIO de
// "Pedidos despachados" (WeeklyMetricRecord del depto con trackWeeklyMetric),
// promediado por mes calendario. Nairoby propone el monto que cobra cada
// persona si se alcanza cada nivel; el admin debe aprobarlo antes de que
// quede activo — por eso amount (vigente) y pendingAmount (propuesta sin
// aprobar) son campos separados. Aprobar copia pendingAmount -> amount.
model CommissionTier {
  id          String  @id @default(cuid())
  name        String  @unique // "Raíz", "Cosecha", "PROVEDIX"
  orderIndex  Int     @unique // 1, 2, 3 — mayor = nivel más alto
  minDailyAvg Float
  maxDailyAvg Float? // solo informativo — superarlo no excluye del nivel más alto
  isActive    Boolean @default(true)

  amounts CommissionTierAmount[]
}

model CommissionTierAmount {
  id     String         @id @default(cuid())
  tierId String
  tier   CommissionTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  userId String
  user   User           @relation("CommissionTierAmountUser", fields: [userId], references: [id], onDelete: Cascade)

  amount        Float     @default(0)
  pendingAmount Float?
  proposedAt    DateTime?
  proposedById  String?
  proposedBy    User?     @relation("CommissionTierAmountProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  // Sin approvedById — solo el admin aprueba, y el admin no tiene fila real
  // en User (mismo motivo por el que otros modelos de este archivo omiten
  // ese campo cuando el actor es exclusivamente el admin).

  @@unique([tierId, userId])
}

// Confirmado 2026-08-17: pedido explícito del usuario — un bono fijo
// mensual por persona (ej. "$50 fijo todos los meses"), que se suma al
// sueldo base. Mismo patrón propone/aprueba que CommissionTierAmount:
// Nairoby (o admin) propone el monto, pero queda inactivo (pendingAmount)
// hasta que el admin lo aprueba. Se paga con el mismo desfase de un mes
// que horas extra/comisiones/bonos CEO — nunca en el mismo mes en que se
// aprueba.
model FixedMonthlyBonus {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("FixedMonthlyBonusUser", fields: [userId], references: [id], onDelete: Cascade)

  amount        Float     @default(0)
  pendingAmount Float?
  proposedAt    DateTime?
  proposedById  String?
  proposedBy    User?     @relation("FixedMonthlyBonusProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
}

enum CeoBonusType {
  ADICIONAL
  PRODUCTIVIDAD
  MERITO
}

// Bono discrecional del CEO — siempre lo otorga el admin (sin fila User),
// por eso no hay grantedById. Confidencial: solo lo ve el destinatario y
// quien administra Nómina (Nairoby/admin) — nunca el resto del equipo.
// Mismo desfase de un mes que horas extra/comisión de equipo: un bono
// otorgado en el mes M se paga en la quincena Q1 del mes M+1.
model CeoBonusGrant {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation("CeoBonusGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  type      CeoBonusType
  note      String?
  grantedAt DateTime     @default(now())

  @@index([userId])
}

// Mismo patrón sin FK que BirthdayPopupSeen/MonthlyRecognitionPopupSeen —
// viewerId es User.id o el string literal "admin".
model CeoBonusGrantSeen {
  id       String   @id @default(cuid())
  viewerId String
  grantId  String
  seenAt   DateTime @default(now())

  @@unique([viewerId, grantId])
}

// Confirmado 2026-08-18: pedido explícito del usuario — egresos automáticos
// de nómina (compras personales, anticipos, descuentos por mala gestión).
// Los tres comparten el mismo mecanismo de cuotas mensuales + desfase de un
// mes (ver installmentAmount/installmentIndexForMonth/resolveFirstPayoutMonth
// en payrollCalc.ts) — firstPayoutMonth se resuelve UNA sola vez, al momento
// en que el egreso queda 100% activo, y de ahí en adelante nunca se
// recalcula (es un hecho puntual, no un valor derivado).

// Confirmado 2026-08-18: rediseño completo, tercera versión del mismo día.
// Ya NO hay catálogo — el colaborador escribe el nombre del producto de
// memoria (sin exactitud) y Daniel lo corrige según el sistema JUST al
// confirmar. Una compra puede llevar varios productos (pedido = orden +
// ítems). El precio en dólares lo digita Nairoby por ítem, sin ningún
// valor precargado — nunca existió catálogo de precios en esta versión.
enum PersonalPurchaseStatus {
  PENDING_INVENTORY
  PENDING_FINANCE
  PENDING_PAYMENT_METHOD // precio cerrado, falta que el colaborador elija cómo paga
  PENDING_TRANSFER_PROOF // eligió transferencia, falta que pegue el comprobante
  PENDING_ADMIN_CONFIRM // comprobante subido, falta que el admin confirme (revisando su banco real)
  PENDING_NAIROBY_CLOSE // admin confirmó, falta que Nairoby/FIN cierre la operación
  APPROVED
  REJECTED
}

enum PersonalPurchasePaymentMethod {
  PAYROLL
  TRANSFER
}

// Para quién es cada unidad declarada (hasta 3 por producto, ver
// PersonalPurchaseItem.unitDeclarations). MINOR_CHILD nunca tiene
// enfriamiento; SELF/OTHER_FAMILY (cualquier otra persona — el mismo
// colaborador, esposa, otro familiar, sin distinción) quedan sujetos al
// enfriamiento de 6 meses.
enum PurchaseBuyerRelation {
  SELF
  MINOR_CHILD
  OTHER_FAMILY
}

model PersonalPurchaseOrder {
  id         String @id @default(cuid())
  employeeId String
  employee   User   @relation("PersonalPurchaseOrderEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  status                 PersonalPurchaseStatus @default(PENDING_INVENTORY)
  inventoryConfirmedAt   DateTime?
  inventoryConfirmedById String?
  financeConfirmedAt     DateTime?
  financeConfirmedById   String?
  rejectedAt             DateTime?
  rejectedById           String?
  rejectionReason        String?

  // El permiso real de retiro — antes era "solo trazabilidad" (Daniel lo
  // marcaba después, sin efecto). Ahora es el gate: Daniel lo setea cuando
  // observa y aprueba el producto que se está llevando, y recién ahí sale
  // el único push real de "ya podés retirarlo". Totalmente independiente
  // del estado de pago (se puede retirar antes de que se resuelva el pago).
  pickedUpAt           DateTime?
  pickedUpApprovedById String?

  eventMonth   String // "YYYY-MM" — mes en que se hizo la compra
  installments Int    @default(1) // libre, sin tope — lo decide Nairoby
  totalAmount  Float? // suma de todos los ítems, se llena al confirmar Nairoby

  // Confirmado 2026-08-20: segunda forma de pago (transferencia), además del
  // descuento en rol de siempre. paymentMethod queda null hasta que el
  // colaborador elige. firstPayoutMonth SOLO se calcula si elige PAYROLL —
  // si elige TRANSFER queda null para siempre, así payroll.ts (que filtra
  // por firstPayoutMonth not null) lo ignora solo, sin poder cobrarlo dos
  // veces. Nunca setear firstPayoutMonth fuera del paso "eligió rol".
  paymentMethod              PersonalPurchasePaymentMethod?
  firstPayoutMonth           String? // resuelto SOLO si eligió PAYROLL (resolveFirstPayoutMonth)
  transferDeadlineAt         DateTime? // addBusinessDays(financeConfirmedAt, 3) — 3 días hábiles para pagar
  transferProofUrl           String?
  transferProofName          String?
  transferProofUploadedAt    DateTime?
  transferAiReadAmount       Float? // lo que leyó la IA del comprobante — informativo, no bloquea
  transferAiMatch            Boolean?
  transferAiNote             String?
  transferAdminConfirmedAt   DateTime? // admin revisó su cuenta real y confirmó (doble paso en la UI)
  transferAdminConfirmedById String?
  transferClosedAt           DateTime? // Nairoby/FIN cierra la operación
  transferClosedById         String?

  items     PersonalPurchaseItem[]
  createdAt DateTime               @default(now())

  @@index([employeeId])
}

model PersonalPurchaseItem {
  id      String                @id @default(cuid())
  orderId String
  order   PersonalPurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  employeeProductName  String // como lo escribió el colaborador, de memoria
  confirmedProductName String? // lo corrige Daniel según JUST — null hasta que confirme

  // Confirmado 2026-08-29: vínculo real al catálogo (antes solo se guardaba
  // el nombre como texto) — el colaborador lo elige al declarar
  // (catalogItemId) y Daniel lo reconfirma/relinkea al aprobar bodega
  // (confirmedCatalogItemId). employeeProductName/confirmedProductName
  // siguen llenándose igual que antes (se usan para el enfriamiento de 6
  // meses en personalPurchases.ts, que no se tocó) — estos dos campos son
  // solo para mostrar el código de Just, no reemplazan esa lógica.
  catalogItemId          String?
  catalogItem            PurchaseCatalogItem? @relation("PersonalPurchaseItemCatalogItem", fields: [catalogItemId], references: [id], onDelete: SetNull)
  confirmedCatalogItemId String?
  confirmedCatalogItem   PurchaseCatalogItem? @relation("PersonalPurchaseItemConfirmedCatalogItem", fields: [confirmedCatalogItemId], references: [id], onDelete: SetNull)

  livePhotoUrl     String
  optionalPhotoUrl String?
  quantity         Int

  // Hasta 3 declaraciones (una por unidad que aspira a precio al costo):
  // [{ relation: "SELF" }, { relation: "MINOR_CHILD", note: "mi hijo Juan" }]
  // Las unidades que sobren de `quantity` sobre este arreglo van a Dropi
  // directo, sin declarar nada.
  unitDeclarations Json

  // Calculado UNA SOLA VEZ al confirmar Daniel (usa confirmedProductName
  // para el enfriamiento de 6 meses, recién confiable con el nombre ya
  // normalizado) — array de "COST"|"DROPI", largo = quantity.
  unitPriceModes Json?

  costUnitPrice  Float? // lo digita Nairoby, sin ningún valor precargado
  dropiUnitPrice Float? // ídem
  itemTotal      Float? // calculado al confirmar Nairoby

  createdAt DateTime @default(now())

  // Confirmado 2026-08-25: enganche automático a Registro de Egresos — en
  // cuanto Daniel aprueba el retiro físico (ver PersonalPurchaseOrder.
  // pickedUpAt), se crea solo, sin que nadie lo vuelva a capturar a mano.
  outflowBatch MerchandiseOutflowBatch?

  @@index([orderId])
}

// Confirmado 2026-08-18: campanita de notificaciones — puramente
// informativa (nunca reemplaza "Pendientes", que sigue igual). Disponible
// para todo el equipo, cada quien ve solo lo suyo (ownerId = User.id, o el
// string literal "admin"). Escrita por notifyOwner() en
// src/lib/notifications.ts, junto con el push en vivo ya existente.
model Notification {
  id        String    @id @default(cuid())
  ownerId   String
  title     String
  body      String
  url       String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([ownerId, createdAt])
}

// Mismos campos que SupplierBankAccount/AdminPaymentPayeeBankAccount.
// Confirmado 2026-08-20: un colaborador puede registrar varias cuentas
// (autoservicio, sin aprobación), pero solo una está marcada isSelected —
// esa es la que se usa para transferir sus anticipos. Reutiliza el enum
// HolderIdType ya existente.
model EmployeeBankAccount {
  id         String @id @default(cuid())
  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  bankName          String
  bankAccountType   String
  bankAccountNumber String
  bankAccountHolder String
  holderIdType      HolderIdType?
  holderIdNumber    String?
  isSelected        Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

// Confirmado 2026-08-20: cuenta única de la empresa para recibir
// transferencias de compras personales — la carga y edita solo el admin,
// en Configuración. Singleton igual que PlatformSettings. Todo nullable
// porque puede no estar configurada todavía.
model CompanyBankAccount {
  id                String        @id @default("singleton")
  bankName          String?
  bankAccountType   String?
  bankAccountNumber String?
  bankAccountHolder String?
  holderIdType      HolderIdType?
  holderIdNumber    String?

  updatedAt DateTime @updatedAt
}

enum SalaryAdvanceStatus {
  PENDING
  APPROVED
  REJECTED
}

// Confirmado 2026-08-20: solo se pide arriba de $100 (validado en la API,
// ver SALARY_ADVANCE_NO_JUSTIFICATION_MAX en payroll.ts). EMERGENCIA_FAMILIAR
// no necesita descripción; OTRO sí (mínimo de caracteres validado en la API).
enum SalaryAdvanceReason {
  EMERGENCIA_FAMILIAR
  OTRO
}

model SalaryAdvance {
  id         String @id @default(cuid())
  employeeId String
  employee   User   @relation("SalaryAdvanceEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  amount        Float
  reason        SalaryAdvanceReason? // obligatorio si amount > 100
  justification String? // obligatorio si amount > 100 y reason = OTRO
  installments  Int                  @default(1) // 1, 2 o 3 (2/3 solo si amount > 50)

  status           SalaryAdvanceStatus @default(PENDING)
  approvedAt       DateTime?
  approvedById     String?
  transferProofUrl String?
  rejectedAt       DateTime?
  rejectedById     String?

  firstPayoutMonth String? // resuelto al aprobar
  createdAt        DateTime @default(now())

  @@index([employeeId])
}

// Solo el admin lo ingresa. acceptedAt = constancia de que el colaborador
// afectado lo aceptó explícitamente — mientras sea null, nunca se aplica a
// ningún rol (el colaborador SIEMPRE debe aceptar primero).
model ManagementDeduction {
  id         String @id @default(cuid())
  employeeId String
  employee   User   @relation("ManagementDeductionEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  totalAmount  Float
  reason       String
  evidenceUrl  String?
  installments Int     @default(1)
  startMonth   String // elegido por el admin al crear

  acceptedAt       DateTime?
  firstPayoutMonth String? // resuelto recién cuando se acepta

  createdById String?
  createdAt   DateTime @default(now())

  @@index([employeeId])
}

/**
 * ---------------- Reingreso de Mercadería ----------------
 * Diseñado y aprobado 2026-08-19 (boceto iterado con el usuario antes de
 * tocar código). Devoluciones de pedidos no entregados (Dropi/Rocket) que
 * regresan a bodega. Flujo de 3 pasos: el equipo de Inventario captura por
 * lote (foto en vivo + reconocimiento por IA contra PurchaseCatalogItem +
 * cantidades buena/dañada), Daniel (líder de Inventario) aprueba, Nairoby
 * (Finanzas) cierra el ciclo — lo bueno a Just, lo dañado a baja.
 */

// Un lote = una sesión de captura de un colaborador de Inventario. Solo
// existe si el candado inicial ("¿ya escaneado como devolución en Dropi o
// Rocket?") se respondió Sí — por eso scanConfirmed no tiene default false,
// el batch nunca se crea con un No. submittedAt congela el lote entero: ni
// el colaborador puede seguir editando items después de eso.
model MerchandiseReentryBatch {
  id          String @id @default(cuid())
  code        String @unique // "RM-0007"
  batchNumber Int    @unique

  createdById String
  createdBy   User     @relation("MerchandiseReentryBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  // Null mientras el colaborador sigue agregando productos (DRAFT real,
  // visible/editable solo para quien lo creó). Se pone al confirmar el envío
  // con doble confirmación — desde ahí el lote entero queda de solo lectura
  // para el colaborador.
  submittedAt DateTime?

  // Se pone cuando TODOS los items del lote ya fueron resueltos por Daniel
  // (aprobados en bloque, o con nombre corregido + decisión de daño tomada).
  danielApprovedAt DateTime?

  // Se pone cuando TODOS los items ya fueron cerrados por Nairoby (parte
  // buena subida a Just y/o parte dañada dada de baja, según corresponda).
  closedAt DateTime?

  items MerchandiseReentryItem[]

  @@index([submittedAt])
  @@index([danielApprovedAt])
  @@index([closedAt])
}

// Un producto dentro de un lote. goodQty/damagedQty conviven en la misma
// fila (mismo producto, mismo lote, puede venir con unidades de ambos
// tipos) — Nairoby cierra cada parte por separado (justUploadedAt vs
// writeOffAt) porque siguen caminos distintos.
model MerchandiseReentryItem {
  id      String                  @id @default(cuid())
  batchId String
  batch   MerchandiseReentryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Solo cámara en vivo (LiveCameraCapture) — nunca subida desde galería,
  // pedido explícito del usuario 2026-08-19.
  photoUrls String[]

  catalogItemId String?
  catalogItem   PurchaseCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  aiRecognized  Boolean              @default(false)
  aiNote        String?

  // Nombre puesto a mano por el colaborador cuando la IA no reconoció el
  // producto. correctedName es la corrección de Daniel (queda el registro de
  // quién y cuándo) — declaredName original nunca se borra, solo se agrega
  // la corrección al lado.
  declaredName  String?
  correctedName String?
  correctedById String?
  correctedBy   User?     @relation("MerchandiseReentryItemCorrectedBy", fields: [correctedById], references: [id], onDelete: SetNull)
  correctedAt   DateTime?

  goodQty    Int @default(0)
  damagedQty Int @default(0)

  damageReasonId    String?
  damageReason      MerchandiseDamageReason? @relation(fields: [damageReasonId], references: [id], onDelete: SetNull)
  damageReasonOther String?

  // Daniel resolvió este item — de un clic si venía todo bien (IA reconoció +
  // 100% bueno), o después de corregir el nombre / decidir sobre el daño.
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("MerchandiseReentryItemApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  // Null mientras no se decide (solo aplica si damagedQty > 0). true = Daniel
  // verificó físicamente que sí está dañado. false = revisó y en realidad
  // está bueno (se trata como parte buena desde ese momento).
  damageConfirmed     Boolean?
  damageConfirmedAt   DateTime?
  damageConfirmedById String?
  damageConfirmedBy   User?     @relation("MerchandiseReentryItemDamageConfirmedBy", fields: [damageConfirmedById], references: [id], onDelete: SetNull)

  // Bifurcación de Daniel una vez confirmado el daño (pedido 2026-08-21,
  // evita el doble proceso reingreso+baja cuando el daño se puede
  // solucionar con un repuesto). Null mientras no decide (solo aplica si
  // damageConfirmed=true). true = solucionado — la unidad vuelve a sumarse
  // a goodQty y sigue el reingreso normal como si nunca se hubiera dañado;
  // el admin recibe la explicación por notificación. false = no
  // solucionado — entra al acumulado semanal de baja
  // (weeklyWriteOffBatch).
  damageSolved       Boolean?
  damageSolvedAt     DateTime?
  damageSolvedById   String?
  damageSolvedBy     User?     @relation("MerchandiseReentryItemDamageSolvedBy", fields: [damageSolvedById], references: [id], onDelete: SetNull)
  damageSolutionNote String? // qué se hizo para habilitarlo de nuevo, solo si damageSolved=true

  // Lote semanal (lunes-sábado) al que queda asignada esta unidad no
  // solucionada, para el corte y la baja en Just.
  weeklyWriteOffBatchId String?
  weeklyWriteOffBatch   MerchandiseWeeklyWriteOffBatch? @relation(fields: [weeklyWriteOffBatchId], references: [id], onDelete: SetNull)

  // Decisión física final de Nairoby, por unidad, después del corte
  // semanal, la baja en Just de Daniel y su propia doble confirmación.
  // Null mientras no decide. true = percha de repuestos. false =
  // destruido. Al decidir se marca writeOffAt (abajo).
  disposalDecision    Boolean?
  disposalDecidedAt   DateTime?
  disposalDecidedById String?
  disposalDecidedBy   User?     @relation("MerchandiseReentryItemDisposalDecidedBy", fields: [disposalDecidedById], references: [id], onDelete: SetNull)

  justUploadedAt   DateTime?
  justUploadedById String?
  justUploadedBy   User?     @relation("MerchandiseReentryItemJustUploadedBy", fields: [justUploadedById], references: [id], onDelete: SetNull)

  // Cierre completo de la parte dañada. Las unidades solucionadas nunca
  // pasan por acá (van por goodQty/justUploadedAt); las no solucionadas lo
  // marcan cuando Nairoby termina su decisión de disposición tras el ciclo
  // semanal.
  writeOffAt   DateTime?
  writeOffById String?
  writeOffBy   User?     @relation("MerchandiseReentryItemWriteOffBy", fields: [writeOffById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([catalogItemId])
}

// Catálogo reutilizable de motivos de daño (mismo patrón que
// WarrantyCategory/StockoutProduct) — se crea una vez, se reutiliza después.
model MerchandiseDamageReason {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  items        MerchandiseReentryItem[]
  outflowItems MerchandiseOutflowItem[]
}

/**
 * ---------------- Registro de Egresos ----------------
 * Confirmado 2026-08-25, diseñado con el usuario en varias rondas: mercadería
 * que SALE del inventario físico por vías que Just no registra solo (no es un
 * despacho normal ya contabilizado como venta) — a diferencia de Reingreso
 * (que es solo devoluciones que VUELVEN), este módulo es la salida. Fase 1
 * cubre despacho (hojas físicas fotografiadas), garantía (manifiesto de
 * Fulfillment), deterioro (encontrado en bodega, no en una devolución) y
 * compras personales (enganche automático). Motivos futuros (cambio con
 * proveedor, ventas externas, guías canceladas) se agregan más adelante al
 * mismo enum/modelo, mismo espíritu: todo cae en UNA sola cola de "dar de
 * baja en Just" para que Daniel no salte entre módulos ni se le olvide.
 */
enum OutflowReason {
  DESPACHO
  GARANTIA
  DETERIORO
  COMPRA_PERSONAL
  // Confirmado 2026-08-25 (Fase 2): mercadería YA registrada en Just que
  // Daniel envía de vuelta a un proveedor para cambio. Sale de Just en el
  // momento en que se manda (por eso entra a la cola de baja de inmediato,
  // no espera la respuesta del proveedor) — la resolución (reemplazo físico
  // o crédito) se rastrea aparte en el item, ver OutflowItemResolution.
  CAMBIO_PROVEEDOR
  // Confirmado 2026-08-25 (Fase 3): ventas por fuera de Dropi/Rocket (ver
  // modelo ExternalSale) — el enganche automático a este batch pasa recién
  // cuando el colaborador de Inventario confirma la entrega física.
  VENTA_EXTERNA
}

// Null mientras está pendiente de que Daniel resuelva un item de deterioro
// (o, en Fase 2, un cambio con proveedor). SOLVED_ONSITE no entra a la cola
// de baja en Just — pedido explícito del usuario, un daño chico arreglado
// ahí mismo no deja rastro en el sistema.
enum OutflowItemResolution {
  SOLVED_ONSITE
  WRITE_OFF
  ESCALATED_TO_PURCHASES
  // Fase 2 — CAMBIO_PROVEEDOR: el proveedor mandó el producto de reemplazo
  // (la llegada física se maneja por la recepción normal de Compras, esto
  // solo cierra el seguimiento acá).
  REPLACED
  // Fase 2 — CAMBIO_PROVEEDOR: el proveedor no cambia el producto, da
  // crédito en su lugar — crea/vincula un SupplierCredit (ver
  // MerchandiseOutflowItem.credit).
  CREDIT_ISSUED
  // Fase 2 — CAMBIO_PROVEEDOR (confirmado 2026-08-27): el proveedor se negó
  // tanto a cambiar el producto como a dar crédito — no crea SupplierCredit,
  // es una pérdida real. Dispara aviso urgente a admin + dos pendientes
  // separados: Nairoby (baja financiera) y Daniel (baja en Just), ver
  // financeWriteOffAt/justWriteOffConfirmedAt en MerchandiseOutflowItem.
  REJECTED
}

model MerchandiseOutflowBatch {
  id          String        @id @default(cuid())
  code        String        @unique // "EG-0001"
  batchNumber Int           @unique
  reason      OutflowReason

  createdById String?
  createdBy   User?    @relation("MerchandiseOutflowBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  // DESPACHO/GARANTIA: fotos del documento físico (hoja de despacho o
  // manifiesto de garantía) que la IA lee para armar el consolidado editable.
  documentPhotoUrls String[]

  // Congela el lote (mismo patrón que Reingreso) una vez se confirma que el
  // consolidado de items es correcto — doble confirmación antes de esto.
  submittedAt DateTime?

  // Checklist final compartido por TODOS los motivos — confirmación humana
  // reforzada de que Daniel ya hizo la baja de verdad en Just (sistema
  // externo, sin integración real).
  justWrittenOffAt   DateTime?
  justWrittenOffById String?
  justWrittenOffBy   User?     @relation("MerchandiseOutflowBatchJustWrittenOffBy", fields: [justWrittenOffById], references: [id], onDelete: SetNull)

  // COMPRA_PERSONAL: enganche automático, un batch = un ítem de compra
  // personal ya aprobado para retiro — nunca se crea a mano, nunca se
  // recaptura desde este módulo.
  personalPurchaseItemId String?               @unique
  personalPurchaseItem   PersonalPurchaseItem? @relation(fields: [personalPurchaseItemId], references: [id], onDelete: SetNull)

  // CAMBIO_PROVEEDOR (Fase 2): a qué proveedor se le envía la mercadería.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // VENTA_EXTERNA (Fase 3): enganche automático, un batch = una venta
  // externa ya entregada — nunca se crea a mano.
  externalSale ExternalSale?

  items MerchandiseOutflowItem[]

  @@index([reason])
  @@index([submittedAt])
  @@index([justWrittenOffAt])
}

model MerchandiseOutflowItem {
  id      String                  @id @default(cuid())
  batchId String
  batch   MerchandiseOutflowBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  catalogItemId String?
  catalogItem   PurchaseCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  declaredName  String
  quantity      Int

  // DETERIORO: foto del producto encontrado dañado + motivo (mismo catálogo
  // fijo de chips que ya usa Reingreso, "Otro" siempre queda como texto
  // libre y nunca crea una fila nueva en el catálogo).
  photoUrls         String[]
  damageReasonId    String?
  damageReason      MerchandiseDamageReason? @relation(fields: [damageReasonId], references: [id], onDelete: SetNull)
  damageReasonOther String?

  // DETERIORO: resolución de Daniel — null mientras está pendiente.
  resolution     OutflowItemResolution?
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?                  @relation("MerchandiseOutflowItemResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  // Fase 2 — CAMBIO_PROVEEDOR resuelto como CREDIT_ISSUED: el crédito
  // creado con el proveedor por este item.
  credit SupplierCredit?

  // CAMBIO_PROVEEDOR (multi-producto, confirmado 2026-08-26): al agregar el
  // producto se busca sola la última compra REAL (ver PRICED_STATUSES en
  // purchases.ts) hecha a ese mismo proveedor por ese mismo producto del
  // catálogo, para saber cuánto se le pagó — así el crédito que se le puede
  // reclamar si no cambia el producto queda estimado de una vez, sin que
  // Daniel tenga que buscarlo a mano. unitCostAtExchange/expectedCreditAmount
  // quedan congelados en el momento de agregar el ítem (no se recalculan si
  // el historial de compras cambia después). Null si no hubo compra previa
  // registrada con ese proveedor para ese producto, o si el producto no está
  // en el catálogo (nombre declarado a mano).
  linkedPurchaseRequestId String?
  linkedPurchaseRequest   PurchaseRequest? @relation("OutflowItemLinkedPurchase", fields: [linkedPurchaseRequestId], references: [id], onDelete: SetNull)
  unitCostAtExchange      Float?
  expectedCreditAmount    Float?

  // Fase 2 — CAMBIO_PROVEEDOR resuelto como REJECTED (confirmado
  // 2026-08-27, pedido explícito del usuario, encadenado 2026-08-28): dos
  // confirmaciones, cada una de una persona distinta — null mientras están
  // pendientes. justWriteOffConfirmedAt = Daniel ya confirmó la baja de esta
  // mercadería en el sistema Just (primer paso). financeWriteOffAt =
  // Nairoby ya registró la pérdida en Finanzas — SOLO puede pasar después de
  // justWriteOffConfirmedAt, nunca antes (ver finance-writeoff/route.ts). El
  // aviso urgente a admin desaparece solo cuando AMBAS ya están hechas.
  financeWriteOffAt         DateTime?
  financeWriteOffById       String?
  financeWriteOffBy         User?     @relation("MerchandiseOutflowItemFinanceWriteOffBy", fields: [financeWriteOffById], references: [id], onDelete: SetNull)
  justWriteOffConfirmedAt   DateTime?
  justWriteOffConfirmedById String?
  justWriteOffConfirmedBy   User?     @relation("MerchandiseOutflowItemJustWriteOffBy", fields: [justWriteOffConfirmedById], references: [id], onDelete: SetNull)

  // Confirmado 2026-08-28, pedido explícito del usuario: revisión del admin
  // sobre un rechazo total del proveedor — puramente informativa/historial,
  // NO bloquea a Nairoby ni a Daniel (ambos pueden confirmar su baja antes,
  // después o sin que el admin haya revisado nunca). Comentario opcional.
  adminReviewedAt   DateTime?
  adminReviewedById String?
  adminReviewedBy   User?     @relation("MerchandiseOutflowItemAdminReviewedBy", fields: [adminReviewedById], references: [id], onDelete: SetNull)
  adminReviewNote   String?

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([resolution])
  @@index([linkedPurchaseRequestId])
}

enum ExternalSaleReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * ---------------- Ventas Externas (Fase 3 de Registro de Egresos) ----------------
 * Confirmado 2026-08-25, diseñado con el usuario en varias rondas: ventas por
 * fuera de Dropi/Rocket — hoy 4 "asesores" (Heidy → Importadora Damián,
 * Jariel → Provedix, Yair → Shanghai, Marcos → contra-entrega con
 * motorizados propios), un solo flujo para los 4 (canDeclareExternalSales).
 * Después de la aprobación de Bryan, pago y despacho son DOS PISTAS
 * INDEPENDIENTES (no un orden fijo) — necesario porque Marcos cobra contra
 * entrega (el pago llega DESPUÉS del despacho) mientras los demás asesores
 * suben el comprobante ANTES. Nairoby solo cierra cuando ambas están listas.
 * Actualizado 2026-08-29, ronda larga con el usuario (idea de Bryan): la
 * pista de despacho se partió en dos — Daniel (Inventario) agrupa y prepara
 * primero, Yair (líder de Fulfilment) embala y entrega después, con su
 * propio colaborador asignado. Se agregó la factura de Nairoby (obligatoria
 * en pago anticipado, opcional en contra entrega). Aprobar/rechazar quedó
 * EXCLUSIVO de Bryan, ni siquiera admin (ver canReviewExternalSales) — admin
 * queda en modo lectura vía canViewExternalSales. El cierre de Nairoby sigue
 * siendo un clic manual suyo (no automático), confirmado explícitamente.
 */

// Cliente final de una venta externa — matriculado UNA vez (nombre, RUC o
// cédula, celular, dirección referencial) y reutilizado en ventas futuras
// por idNumber (único), en vez de texto libre repetido cada vez. Los datos
// legales existen para que, si el cliente pide factura, Nairoby ya los
// tenga a mano sin perseguirlos después.
model Client {
  id       String       @id @default(cuid())
  name     String
  idType   HolderIdType
  idNumber String       @unique
  phone    String
  address  String // dirección referencial

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  sales ExternalSale[]
}

model ExternalSale {
  id         String @id @default(cuid())
  code       String @unique // "VE-0001"
  saleNumber Int    @unique

  advisorId String
  advisor   User   @relation("ExternalSaleAdvisor", fields: [advisorId], references: [id], onDelete: Restrict)

  catalogItemId       String?
  catalogItem         PurchaseCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  declaredProductName String
  quantity            Int
  unitPrice           Float
  totalAmount         Float // quantity * unitPrice, calculado al declarar

  // Cliente final que compra — matriculado antes de declarar la venta (ver
  // model Client). Nullable porque ventas declaradas antes de este campo
  // no lo tienen. clientName/clientPhone quedan huérfanos abajo, sin uso
  // nuevo, solo por compatibilidad con la única venta que los tuvo.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  clientName  String?
  clientPhone String?

  // Congelado desde User.externalSaleContraEntrega al declarar (hoy true
  // solo para Marcos). Define el orden del flujo: contra entrega despacha
  // primero y cobra después (máx. 48h desde la entrega); pago anticipado
  // espera el comprobante Y la factura de Nairoby antes de pasar a Daniel.
  isContraEntrega Boolean @default(false)

  // A quién debe entregarle bodega el pedido (motorizado o cliente) — el
  // colaborador de Inventario que despacha ve SOLO esto, nunca los montos.
  pickupPersonName String

  // Informativo — cuando recoge un courier distinto al habitual (ej. caso
  // del aceite de batana). Nunca cambia el proceso, solo trazabilidad.
  courierNote String?

  createdAt DateTime @default(now())

  reviewStatus    ExternalSaleReviewStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?                    @relation("ExternalSaleReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?

  // Pista 1 — pago. El asesor sube el comprobante (Pichincha o wallet a
  // wallet Dropi, o lo que transfiera el motorizado de Marcos ya
  // descontado su flete); admin confirma con doble check que llegó.
  paymentProofUrl        String?
  paymentProofName       String?
  paymentProofUploadedAt DateTime?
  paymentConfirmedAt     DateTime?
  paymentConfirmedById   String?
  paymentConfirmedBy     User?     @relation("ExternalSalePaymentConfirmedBy", fields: [paymentConfirmedById], references: [id], onDelete: SetNull)

  // Factura de Nairoby — confirmado 2026-08-29: obligatoria en pago
  // anticipado (bloquea a Daniel hasta que se sube), opcional en contra
  // entrega (solo si el cliente final la pidió).
  invoiceUrl          String?
  invoiceName         String?
  invoiceUploadedAt   DateTime?
  invoiceUploadedById String?
  invoiceUploadedBy   User?     @relation("ExternalSaleInvoiceUploadedBy", fields: [invoiceUploadedById], references: [id], onDelete: SetNull)

  // Pista 2, paso 1 — Daniel (Inventario) asigna a un colaborador de su
  // equipo para agrupar los productos de la venta según la guía.
  dispatchAssignedToId String?
  dispatchAssignedTo   User?     @relation("ExternalSaleDispatchAssignedTo", fields: [dispatchAssignedToId], references: [id], onDelete: SetNull)
  dispatchAssignedAt   DateTime?
  dispatchAssignedById String?
  dispatchAssignedBy   User?     @relation("ExternalSaleDispatchAssignedBy", fields: [dispatchAssignedById], references: [id], onDelete: SetNull)

  // El colaborador de Daniel toma fotos de los productos según la guía y
  // marca listo — recién ahí pasa al equipo de Fulfilment (Yair) para
  // embalar y entregar.
  prepPhotoUrl  String?
  prepReadyAt   DateTime?
  prepReadyById String?
  prepReadyBy   User?     @relation("ExternalSalePrepReadyBy", fields: [prepReadyById], references: [id], onDelete: SetNull)

  // Pista 2, paso 2 — Yair (líder de Fulfilment) asigna a alguien de su
  // equipo para embalar; esa misma persona hace la entrega final abajo.
  packAssignedToId String?
  packAssignedTo   User?     @relation("ExternalSalePackAssignedTo", fields: [packAssignedToId], references: [id], onDelete: SetNull)
  packAssignedAt   DateTime?
  packAssignedById String?
  packAssignedBy   User?     @relation("ExternalSalePackAssignedBy", fields: [packAssignedById], references: [id], onDelete: SetNull)

  // Entrega final al motorizado — foto en tiempo real (nunca un archivo
  // subido), la toma la misma persona que embaló. Acá es cuando el stock
  // sale de verdad (dispara el enganche a Egresos) y arranca el reloj de
  // los 3 días hábiles.
  deliveryPhotoUrl String?
  deliveredAt      DateTime?
  deliveredById    String?
  deliveredBy      User?     @relation("ExternalSaleDeliveredBy", fields: [deliveredById], references: [id], onDelete: SetNull)

  // Nairoby cierra la venta — solo posible cuando pago Y despacho ya están
  // resueltos, sin importar el orden en que hayan pasado.
  nairobyClosedAt   DateTime?
  nairobyClosedById String?
  nairobyClosedBy   User?     @relation("ExternalSaleNairobyClosedBy", fields: [nairobyClosedById], references: [id], onDelete: SetNull)

  // Enganche automático a Registro de Egresos — se crea apenas el
  // colaborador confirma la entrega (ahí es cuando el stock sale de verdad).
  outflowBatchId String?                  @unique
  outflowBatch   MerchandiseOutflowBatch? @relation(fields: [outflowBatchId], references: [id], onDelete: SetNull)

  @@index([reviewStatus])
  @@index([dispatchAssignedToId])
  @@index([packAssignedToId])
  @@index([advisorId])
}

// Acumulado semanal (lunes-sábado) de unidades dañadas "no solucionadas"
// (ver MerchandiseReentryItem.damageSolved). Nairoby lo ve en tiempo real
// y de solo lectura mientras se acumula. Al terminar la semana, Daniel
// hace la baja en Just (sistema externo) y marca justWrittenOffAt — desde
// ahí Nairoby verifica físicamente el listado contra los productos reales
// y hace la doble confirmación (nairobyConfirmedAt) antes de decidir, por
// unidad, destruir o pasar a la percha de repuestos
// (MerchandiseReentryItem.disposalDecision).
model MerchandiseWeeklyWriteOffBatch {
  id        String   @id @default(cuid())
  weekStart DateTime // lunes 00:00 de esa semana calendario
  weekEnd   DateTime // sábado 23:59:59.999 de esa semana calendario
  createdAt DateTime @default(now())

  justWrittenOffAt   DateTime?
  justWrittenOffById String?
  justWrittenOffBy   User?     @relation("MerchandiseWeeklyWriteOffBatchJustBy", fields: [justWrittenOffById], references: [id], onDelete: SetNull)

  nairobyConfirmedAt   DateTime?
  nairobyConfirmedById String?
  nairobyConfirmedBy   User?     @relation("MerchandiseWeeklyWriteOffBatchNairobyBy", fields: [nairobyConfirmedById], references: [id], onDelete: SetNull)

  items MerchandiseReentryItem[]

  @@unique([weekStart])
  @@index([justWrittenOffAt])
  @@index([nairobyConfirmedAt])
}

enum CancelledGuideSourceArea {
  // Análisis de Mercado — el remitente elige a mano de qué bodega es (no se
  // infiere del nombre de la persona, decisión deliberada para no atar el
  // código a que "Heidy siempre es Damián" si eso cambia algún día).
  MKT_DAMIAN
  MKT_PROVEDIX
  FULFILLMENT
}

enum CancelledGuideCarrier {
  SERVIENTREGA
  URBANO
  GINTRANCOM
  LAARCOURIER
  VELOCES
}

/**
 * ---------------- Guías Canceladas (Fase 4 de Registro de Egresos) ----------------
 * Confirmado 2026-08-25: aunque el resultado final sea una ENTRADA (la
 * mercadería nunca salió, hay que reingresarla a Just), el usuario pidió
 * explícitamente que viva dentro de Registro de Egresos, junto a los demás
 * motivos, para no tener a Daniel saltando entre módulos.
 * Lo sube cualquiera de Análisis de Mercado (Heidy/Jariel, bodega
 * Damián/Provedix) o de Fulfillment (Yair) — motivos distintos según el
 * área. Fulfillment e Inventario confirman por separado que hicieron su
 * gestión (no despachar); Bryan hace el corte semanal decidiendo, guía por
 * guía, si realmente se canceló o si se despachó igual por otro motivo —
 * eso no lo puede saber el sistema solo, es juicio humano contra lo que
 * pasó de verdad en Dropi/Rocket. Solo lo realmente cancelado entra a la
 * cola de Daniel para reingresar a Just.
 */
model CancelledGuideReport {
  id           String @id @default(cuid())
  code         String @unique // "GC-0001"
  reportNumber Int    @unique

  submittedById String
  submittedBy   User                     @relation("CancelledGuideSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  sourceArea    CancelledGuideSourceArea

  guideNumber String
  carrier     CancelledGuideCarrier
  // "Solicitud del dropshipper" / "Falta de stock" (MKT) o "No cumple
  // medidas o peso" (Fulfillment) / texto libre si elige "Otro".
  reason      String

  createdAt DateTime @default(now())

  items CancelledGuideItem[]

  // Cada área responsable confirma POR SEPARADO que hizo su parte (no
  // despachar) — un botón, sin más detalle que pedir.
  fulfillmentConfirmedAt   DateTime?
  fulfillmentConfirmedById String?
  fulfillmentConfirmedBy   User?     @relation("CancelledGuideFulfillmentConfirmedBy", fields: [fulfillmentConfirmedById], references: [id], onDelete: SetNull)

  inventoryConfirmedAt   DateTime?
  inventoryConfirmedById String?
  inventoryConfirmedBy   User?     @relation("CancelledGuideInventoryConfirmedBy", fields: [inventoryConfirmedById], references: [id], onDelete: SetNull)

  // Corte semanal de Bryan — null mientras está pendiente de decidir.
  reallyCancelled   Boolean?
  cutoffDecidedAt   DateTime?
  cutoffDecidedById String?
  cutoffDecidedBy   User?     @relation("CancelledGuideCutoffDecidedBy", fields: [cutoffDecidedById], references: [id], onDelete: SetNull)

  // Daniel reingresa a Just — solo aplica cuando reallyCancelled = true.
  reingresadoAt   DateTime?
  reingresadoById String?
  reingresadoBy   User?     @relation("CancelledGuideReingresadoBy", fields: [reingresadoById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([reallyCancelled])
  @@index([submittedById])
}

model CancelledGuideItem {
  id       String               @id @default(cuid())
  reportId String
  report   CancelledGuideReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  catalogItemId String?
  catalogItem   PurchaseCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  declaredName  String
  quantity      Int

  @@index([reportId])
}
